<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Product card opened by a hotspot dot: live price, stock and what the shopper can do -->
    <t t-name="scita_smart_commerce.HotspotCard">
        <div class="o_scita_hotspot_card" role="dialog" t-att-aria-label="product.name">
            <button type="button" class="btn-close o_scita_hotspot_card_close" aria-label="Close"/>
            <div class="o_scita_hotspot_card_body">
                <a t-att-href="product.url" class="o_scita_hotspot_card_img" tabindex="-1">
                    <img t-att-src="product.image_url" t-att-alt="product.name" loading="lazy"/>
                    <span t-if="product.discount and product.in_stock" class="o_scita_hotspot_card_badge">-<t t-out="product.discount"/>%</span>
                </a>
                <div class="o_scita_hotspot_card_info">
                    <a t-att-href="product.url" class="o_scita_hotspot_card_name" t-out="product.name"/>
                    <div class="o_scita_hotspot_card_price">
                        <t t-if="product.price_login"/>
                        <t t-elif="product.hide_price">
                            <span class="o_scita_hotspot_card_request">Price on request</span>
                        </t>
                        <t t-else="">
                            <span class="o_scita_hotspot_card_amount" t-out="product.price"/>
                            <del t-if="product.compare_price" class="o_scita_hotspot_card_old" t-out="product.compare_price"/>
                        </t>
                    </div>
                    <span t-if="!product.in_stock" class="o_scita_hotspot_card_stock">Out of stock</span>
                </div>
            </div>
            <div class="o_scita_hotspot_card_actions">
                <button t-if="product.can_add_to_cart" type="button" class="btn btn-primary o_scita_hotspot_card_add">
                    <i class="fa fa-shopping-cart" aria-hidden="true"/> Add to cart
                </button>
                <a t-elif="product.price_login" t-attf-href="/web/login?redirect={{product.url}}" class="btn btn-primary">
                    Login to see price
                </a>
                <a t-elif="product.hide_price" t-att-href="product.url" class="btn btn-primary">
                    Request a quote <i class="fa fa-arrow-right" aria-hidden="true"/>
                </a>
                <a t-elif="product.needs_options and product.in_stock" t-att-href="product.url" class="btn btn-primary">
                    Choose options <i class="fa fa-arrow-right" aria-hidden="true"/>
                </a>
                <a t-else="" t-att-href="product.url" class="btn btn-outline-primary">
                    View product <i class="fa fa-arrow-right" aria-hidden="true"/>
                </a>
                <button t-if="product.has_ar" type="button" class="btn btn-outline-secondary o_scita_hotspot_card_ar">
                    <i class="fa fa-cube" aria-hidden="true"/> <t t-out="arLabel"/>
                </button>
            </div>
        </div>
    </t>

</templates>
