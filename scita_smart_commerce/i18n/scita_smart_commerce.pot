#. module: scita_smart_commerce
#: model:mail.template,body_html:scita_smart_commerce.mail_template_price_alert_confirm
msgid ""
"<div style=\"margin: 0; padding: 0; font-family: Arial, sans-serif; color: #212529;\">\n"
"    <p>Hello,</p>\n"
"    <p>\n"
"        Someone (hopefully you) asked us to email this address when the price of\n"
"        <strong t-out=\"object._scita_product_name()\">Product</strong>\n"
"        <t t-out=\"object._scita_condition_text() or ''\">reaches $ 90.00 or less</t>.\n"
"    </p>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <a t-att-href=\"object._scita_confirm_url()\" style=\"background-color: #875A7B; color: #ffffff; padding: 10px 20px; text-decoration: none; border-radius: 4px;\">\n"
"            Confirm my price alert\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"font-size: 12px; color: #6c757d;\">\n"
"        If you did not ask for this, just ignore this email: without confirmation the alert is deleted after 7 days\n"
"        and you will not hear from us again.\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

#. module: scita_smart_commerce
#: model:mail.template,body_html:scita_smart_commerce.mail_template_price_alert
msgid ""
"<div style=\"margin: 0; padding: 0; font-family: Arial, sans-serif; color: #212529;\">\n"
"    <t t-set=\"saving\" t-value=\"object._scita_saving()\"/>\n"
"    <t t-set=\"stock_left\" t-value=\"object._scita_stock_left()\"/>\n"
"    <p>Hello,</p>\n"
"    <p>\n"
"        Good news: the product you are watching just got cheaper.\n"
"    </p>\n"
"    <table cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; max-width: 560px; border: 1px solid #dee2e6; border-radius: 8px; margin: 16px 0;\">\n"
"        <tr>\n"
"            <td t-if=\"object.product_id.image_128\" style=\"padding: 16px; width: 140px; vertical-align: top;\">\n"
"                <img t-attf-src=\"{{ object.website_id.get_base_url() }}/web/image/product.product/{{ object.product_id.id }}/image_256\" alt=\"\" style=\"width: 120px; height: 120px; object-fit: contain; border-radius: 8px;\"/>\n"
"            </td>\n"
"            <td t-attf-style=\"padding: {{ '16px 16px 16px 0' if object.product_id.image_128 else '16px' }}; vertical-align: top;\">\n"
"                <div style=\"font-size: 16px; font-weight: bold; margin-bottom: 8px;\" t-out=\"object._scita_product_name()\">Product</div>\n"
"                <div>\n"
"                    <span t-if=\"saving[0]\" style=\"text-decoration: line-through; color: #6c757d; margin-right: 8px;\" t-out=\"object._scita_format(object.price_at_creation) or ''\">$ 100.00</span>\n"
"                    <span style=\"font-size: 22px; font-weight: bold; color: #198754;\" t-out=\"object._scita_format(object.last_price) or ''\">$ 90.00</span>\n"
"                </div>\n"
"                <div t-if=\"saving[0]\" style=\"margin-top: 4px; color: #198754;\">\n"
"                    You save <strong t-out=\"object._scita_format(saving[0]) or ''\">$ 10.00</strong>\n"
"                    (<t t-out=\"saving[1]\">10</t>%)\n"
"                </div>\n"
"                <div t-if=\"stock_left\" style=\"margin-top: 8px; color: #dc3545; font-weight: bold;\">\n"
"                    Only <t t-out=\"stock_left\">3</t> left at this price\n"
"                </div>\n"
"            </td>\n"
"        </tr>\n"
"    </table>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <a t-att-href=\"object._scita_product_url()\" style=\"background-color: #875A7B; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 4px; font-weight: bold;\">\n"
"            Buy now at <t t-out=\"object._scita_format(object.last_price) or ''\">$ 90.00</t>\n"
"        </a>\n"
"    </p>\n"
"    <p style=\"font-size: 12px; color: #6c757d;\">\n"
"        You asked us to email you when the price <t t-out=\"object._scita_condition_text() or ''\">drops</t>.\n"
"        Prices can change at any time. This alert is now done:\n"
"        <a t-att-href=\"object._scita_rearm_url()\" style=\"color: #875A7B;\">keep watching for a lower price</a>\n"
"        or <a t-att-href=\"object._scita_unsubscribe_url()\" style=\"color: #6c757d;\">stop this alert</a>.\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""

