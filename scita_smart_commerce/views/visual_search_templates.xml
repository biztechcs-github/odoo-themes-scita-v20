<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Camera button in every website search box (header, shop, search modal).
         After the submit button: Theme Scita rewrites the class of the box's first <button>
         (theme_scita.search_btn_primary_class_remove); the classes are in t-attf-class so no
         static class rewrite can drop them. -->
    <template id="visual_search_button" inherit_id="website.website_search_box" name="Scita Visual Search Button">
        <xpath expr="//div[@role='search']/button[@type='submit']" position="after">
            <button t-if="website and website.scita_visual_search_enabled and website._scita_ai_ready()"
                    type="button"
                    t-attf-class="btn o_scita_visual_search_btn o_not_editable"
                    title="Search by photo" aria-label="Search by photo">
                <i class="oi" data-icon="photo_camera" role="img"/>
            </button>
        </xpath>
    </template>

    <!-- One modal per page, opened by any camera button -->
    <template id="visual_search_modal" inherit_id="website.layout" name="Scita Visual Search Modal">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <div t-if="website and website.scita_visual_search_enabled and website._scita_ai_ready()"
                 id="o_scita_visual_search_modal" class="modal fade o_scita_visual_search_modal"
                 tabindex="-1" aria-labelledby="o_scita_vs_title" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="o_scita_vs_title">Search by photo</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                        </div>
                        <div class="modal-body">
                            <div class="o_scita_vs_picker text-center py-4 px-3 rounded border border-2 border-dashed">
                                <i class="oi fs-1 text-muted" data-icon="photo_camera" role="img" aria-hidden="true"/>
                                <p class="mt-2 mb-3">Upload or snap a photo of what you are looking for and we will find similar products.</p>
                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    <label class="btn btn-primary mb-0">
                                        Upload a photo
                                        <input type="file" accept="image/*" class="d-none o_scita_vs_file"/>
                                    </label>
                                    <label class="btn btn-outline-primary mb-0 d-lg-none">
                                        Take a photo
                                        <input type="file" accept="image/*" capture="environment" class="d-none o_scita_vs_file"/>
                                    </label>
                                </div>
                                <p class="small text-muted mt-3 mb-0">Your photo is only used for this search and is not stored.</p>
                            </div>
                            <div class="o_scita_vs_preview d-none">
                                <div class="d-flex flex-column flex-sm-row gap-3 align-items-sm-center">
                                    <img class="o_scita_vs_preview_img rounded border" alt="Your photo"/>
                                    <div class="flex-grow-1">
                                        <div class="o_scita_vs_status small text-muted" role="status" aria-live="polite"/>
                                        <div class="o_scita_vs_chips d-flex flex-wrap gap-1 mt-2"/>
                                        <button type="button" class="btn btn-link px-0 mt-2 o_scita_vs_reset">Try another photo</button>
                                    </div>
                                </div>
                            </div>
                            <div class="o_scita_vs_error alert alert-warning d-none mt-3 mb-0" role="alert"/>
                            <div class="o_scita_vs_results row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 mt-1"/>
                        </div>
                        <div class="modal-footer o_scita_vs_footer d-none">
                            <a class="btn btn-secondary o_scita_vs_all" href="/shop">See all results</a>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
