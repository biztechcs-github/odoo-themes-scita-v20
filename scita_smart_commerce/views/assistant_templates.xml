<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Floating AI shopping assistant: rendered only when enabled and an API key is set
         (also for logged-in shop owners: `editable` means "may edit", not "editing").
         Hidden while the website editor is open, see assistant.scss, and in the translation
         editor (`edit_translations`; `translatable` is true for any editor viewing a page in a
         language other than the default one, which hid the assistant from them on all
         translated pages). -->
    <template id="assistant_bubble" inherit_id="website.layout" name="Scita AI Shopping Assistant">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <t t-if="website and website.scita_assistant_enabled and not edit_translations and website._scita_ai_ready()">
                <div class="o_scita_assistant d-print-none"
                     t-att-data-name="website.scita_assistant_name or 'Shopping Assistant'"
                     t-att-data-welcome="website.scita_assistant_welcome or ''">
                    <button type="button" class="o_scita_assistant_toggle btn rounded-circle shadow"
                            aria-expanded="false" aria-controls="o_scita_assistant_panel"
                            t-att-aria-label="website.scita_assistant_name or 'Shopping Assistant'"
                            t-att-title="website.scita_assistant_name or 'Shopping Assistant'">
                        <span class="o_scita_assistant_icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
                                <path d="M12 3C6.5 3 2 6.9 2 11.7c0 2.4 1.1 4.6 3 6.2-.2 1.3-.8 2.6-1.8 3.6 1.9 0 3.7-.7 5-1.8 1.2.4 2.5.6 3.8.6 5.5 0 10-3.9 10-8.7S17.5 3 12 3zm-4.5 9.9a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4zm4.5 0a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4zm4.5 0a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4z"/>
                            </svg>
                        </span>
                    </button>
                    <section id="o_scita_assistant_panel" class="o_scita_assistant_panel shadow-lg d-none"
                             role="dialog" aria-modal="false"
                             t-att-aria-label="website.scita_assistant_name or 'Shopping Assistant'">
                        <header class="o_scita_assistant_header">
                            <strong class="o_scita_assistant_title" t-out="website.scita_assistant_name or 'Shopping Assistant'"/>
                            <div class="d-flex gap-1">
                                <button type="button" class="o_scita_assistant_reset btn btn-sm btn-link" title="New conversation" aria-label="New conversation">&#8635;</button>
                                <button type="button" class="o_scita_assistant_close btn btn-sm btn-link" title="Close" aria-label="Close">&#10005;</button>
                            </div>
                        </header>
                        <div class="o_scita_assistant_messages" role="log" aria-live="polite"/>
                        <form class="o_scita_assistant_form o_no_wait_lazy_js">
                            <label class="visually-hidden" for="o_scita_assistant_input">Your question</label>
                            <textarea id="o_scita_assistant_input" class="o_scita_assistant_input form-control" rows="1"
                                      maxlength="2000" placeholder="Ask about our products..."/>
                            <button type="submit" class="o_scita_assistant_send btn btn-primary" aria-label="Send">&#10148;</button>
                        </form>
                        <p class="o_scita_assistant_disclaimer">AI answers can contain mistakes. Check product pages before buying.</p>
                    </section>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
