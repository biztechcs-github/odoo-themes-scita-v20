<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Comparison page: "Explain the differences" asks the AI for a short answer shown as a
         table (one column per product), "best for" cards and a one-line summary
         (compare_ai.js). Same look as the 3D viewer and the photo search. -->
    <template id="compare_ai_explain" inherit_id="website_sale.product_compare" name="Scita AI Comparison">
        <xpath expr="//div[@id='o_comparelist_table']/.." position="after">
            <section t-if="website.scita_compare_ai_enabled and website._scita_ai_ready() and 2 &lt;= len(products) &lt;= 4"
                     class="o_scita_compare_ai my-4"
                     t-att-data-product-ids="products.ids">
                <div class="o_scita_compare_ai_head">
                    <span class="o_scita_compare_ai_icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 3.5l1.8 4.7 4.7 1.8-4.7 1.8L12 16.5l-1.8-4.7L5.5 10l4.7-1.8z"/><path d="M18.5 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg>
                    </span>
                    <div class="o_scita_compare_ai_intro">
                        <h2 class="o_scita_compare_ai_title">Not sure which one to pick?</h2>
                        <p>Get a short, plain-language summary of the real differences, based only on our product information.</p>
                    </div>
                    <button type="button" class="btn btn-primary o_scita_compare_ai_btn">
                        <span class="o_scita_compare_ai_spinner spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"/>
                        <span>Explain the differences</span>
                    </button>
                </div>
                <div class="o_scita_compare_ai_result" aria-live="polite"/>
            </section>
        </xpath>
    </template>
</odoo>
