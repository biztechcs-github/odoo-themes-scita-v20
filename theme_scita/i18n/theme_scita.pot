msgid ""
"];\n"
"        self.addEventListener('install', function (ev) {\n"
"    // take over right away so an old worker (which cached backend pages) stops controlling tabs\n"
"    self.skipWaiting();\n"
"          ev.waitUntil(\n"
"           caches.open(PWA_CACHE_NAME).then(function (cache) {\n"
"               return cache.addAll(URL_TO_CACHE);\n"
"           })\n"
"          );\n"
"        });\n"
"        self.addEventListener('activate', function(ev) {\n"
"           ev.waitUntil(\n"
"               caches.keys().then(function(keyList) {\n"
"                   return Promise.all(keyList.map(function(key) {\n"
"                       if (key !== PWA_CACHE_NAME) {\n"
"                           return caches.delete(key);\n"
"                       }\n"
"                   }));\n"
"               })\n"
"           );\n"
"          self.clients.claim();\n"
"        });\n"
"        // Only website assets/images/pages are handled. The backend, RPC/JSON calls, the bus and the\n"
"// editor are never intercepted: replaying cached copies of those (e.g. while the server restarts)\n"
"// brought back stale sessions / CSRF tokens and showed \"session expired\" to logged-in users.\n"
"function scitaSkip(req) {\n"
"    if (req.method !== 'GET' || !req.url.startsWith(self.location.origin)) {\n"
"        return true;\n"
"    }\n"
"    const url = new URL(req.url);\n"
"    const path = url.pathname;\n"
"    if (url.searchParams.has('debug')) {\n"
"        return true;\n"
"    }\n"
"    if (path === '/web/login' || path.startsWith('/odoo') || path.startsWith('/@/') ||\n"
"        path.startsWith('/websocket') || path.startsWith('/longpolling') || path.startsWith('/bus') ||\n"
"        path.startsWith('/json') || path.startsWith('/mail/') || path.startsWith('/website/') ||\n"
"        path.startsWith('/my') || path.startsWith('/shop/cart') || path.startsWith('/shop/checkout') ||\n"
"        path.startsWith('/shop/payment') || path.startsWith('/shop/confirm')) {\n"
"        return true;\n"
"    }\n"
"    // /web/* is backend except static bundles and images\n"
"    if (path.startsWith('/web')) {\n"
"        const isStatic = ['/web/assets/', '/web/image', '/web/content'].some(function (p) { return path.startsWith(p); });\n"
"        return !isStatic;\n"
"    }\n"
"    return false;\n"
"}\n"
"self.addEventListener('fetch', function(ev) {\n"
"    const req = ev.request;\n"
"    if (!req.url.startsWith('http') || scitaSkip(req)) {\n"
"        return; // let the browser handle it normally\n"
"    }\n"
"    if (req.mode === 'navigate') {\n"
"        // pages: always from the network (fresh session/CSRF); offline page only when offline\n"
"        ev.respondWith(\n"
"            fetch(req).catch(function () {\n"
"                return caches.open(PWA_CACHE_NAME).then(function (cache) {\n"
"                    return cache.match('/theme_scita/pwa/offline');\n"
"                }).then(function (res) {\n"
"                    return res || Response.error();\n"
"                });\n"
"            })\n"
"        );\n"
"        return;\n"
"    }\n"
"    // static assets / images: network first, cache as fallback\n"
"    ev.respondWith(\n"
"        fetch(req)\n"
"        .then(function(res) {\n"
"            if (res ? (res.status === 200 ? res.type === 'basic' : false) : false) {\n"
"                const resToCache = res.clone();\n"
"                caches.open(PWA_CACHE_NAME).then(function(cache) {\n"
"                    cache.put(req, resToCache);\n"
"                });\n"
"            }\n"
"            return res;\n"
"        })\n"
"        .catch(function() {\n"
"            return caches.open(PWA_CACHE_NAME).then(function(cache) {\n"
"                return cache.match(req);\n"
"            }).then(function (res) {\n"
"                // aborted or offline with nothing cached: a plain network error, never undefined\n"
"                return res || Response.error();\n"
"            });\n"
"        })\n"
"    );\n"
"});"
