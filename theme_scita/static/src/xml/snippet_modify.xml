<!-- Odoo 20 builds the option panel from website.BuilderOptions only (the `builder_options`
     plugin resource of 19 is no longer read), so the "Modify" options are declared here,
     in the top hook: right under the block's title, above Layout / Background -->
<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//t[@id='top_options_hook']" position="after">
        <scita_category_slider_3_option_modify template="theme_scita_category_slider_3_option" selector=".cat_slider_3"/>
        <scita_category_slider_4_option_modify template="theme_scita_category_slider_4_option" selector=".cat_slider_4"/>
        <scita_product_category_option_modify template="product_category_option" selector=".oe_category_slider"/>
        <scita_category_slider_option_modify template="theme_scita_category_slider_option" selector=".oe_cat_slider"/>
        <scita_fashion_multi_cat_custom_snippet_modify template="fashion_multi_cat_custom_snippet" selector=".fashion_multi_category_slider"/>
        <scita_dynamic_video_banner_modify template="dynamic_video_banner" selector=".dynamic_video_banner"/>
        <scita_deal_seller_multi_product_custom_snippet_modify template="deal_seller_multi_product_custom_snippet" selector=".deal_multi_product_slider"/>
        <scita_deal_of_the_day_option_modify template="theme_scita_deal_of_the_day_option" selector=".oe_deal_of_the_day"/>
        <scita_deal_of_day_banner_1_option_modify template="theme_scita_deal_of_day_banner_1_option" selector=".retial_deal_of_day_banner_snippet_1"/>
        <scita_deal_of_day_banner_3_option_modify template="theme_scita_deal_of_day_banner_3_option" selector=".deal_of_day_banner_3"/>
        <scita_deal_of_day_banner_5_option_modify template="theme_scita_deal_of_day_banner_5_option" selector=".deal_of_day_banner_5"/>
        <scita_brands_box_option_modify template="brands_box_option" selector=".box_brand_slider"/>
        <scita_it_brand_option_modify template="it_brand_option" selector=".it_brand_slider"/>
        <scita_sct_product_snippet_1_option_modify template="sct_product_snippet_1_option" selector=".sct_product_snippet_1"/>
        <scita_sct_product_snippet_2_option_modify template="sct_product_snippet_2_option" selector=".sct_product_snippet_2"/>
        <scita_trending_products_option_modify template="theme_scita_trending_products_option" selector=".theme_scita_trending_products"/>
        <scita_s_google_map_option_modify template="s_google_map_option" selector=".google_map_v1"/>
        <scita_s_google_map_option_c_modify template="s_google_map_option_c" selector=".google_map_v2"/>
        <scita_blog_slider_option_modify template="theme_scita_blog_slider_option" selector=".scita_blog_slider"/>
        <scita_blog_4_custom_snippet_option_modify template="blog_4_custom_snippet_option" selector=".blog_4_custom"/>
        <scita_blog_2_custom_snippet_option_modify template="blog_2_custom_snippet_option" selector=".blog_2_custom"/>
        <scita_blog_5_custom_snippet_option_modify template="blog_5_custom_snippet_option" selector=".blog_5_custom"/>
    </xpath>
    <!-- Location Snippet: no Layout (grid) option. Dragging a card turns the first row of the
         container into a grid, here the title row, not the cards' one: the card was dropped
         there with no size (g-col-lg-NaN) and the editor broke -->
    <xpath expr="//layout_option" position="attributes">
        <attribute name="exclude" add=".health_location_snippet, .health_cash_study_snippet, .case_study_varient_2, .about_us_v_4, .about_us_v_5, .it_main_banner, .fashion_static_brand_snippet, .content_snippets_v_6, .how_it_work_v_3, .how_it_work_v_4, .how_it_work_v_5, .pricing_table_v2, .pricing_table_v5, .retial_advertisement_banner_1, .it_portfolio_tabs, .portfolio_snippet_1, .portfolio_snippet_2, .service_varient_11, .testinomial_varient_5, .timeline_snippet_1, .timeline_snippet_3" separator=", "/>
    </xpath>
</t>
</templates>
