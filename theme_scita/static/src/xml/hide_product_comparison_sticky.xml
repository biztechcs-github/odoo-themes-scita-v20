<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="website_sale.ProductRow" t-inherit-mode="extension">
        <!-- Scita shows a "Price is hidden" note when prices are hidden (website or product
             setting); zero-price products (sale prevented) show nothing, as on 19. -->
        <xpath expr="//small[@t-if='!this.props.hide_price']" position="before">
            <small t-if="this.props.hide_price and this.props.price" class="mb-0 text-body text-danger">
                    Price is hidden
            </small>
        </xpath>
    </t>
    <t t-inherit="website_sale.ProductComparisonBottomBar" t-inherit-mode="extension">
        <xpath expr="//div[@name='comparison_bottom_bar']" position="attributes">
            <attribute name="t-if">this.state.products.size and (typeof window !== 'undefined' and window.location.pathname !== '/')</attribute>
        </xpath>
    </t>
</templates>
