<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Scita Headers 1-5 of Header > Template: static/src/js/header_templates_plugin.js -->
    
<!-- Wishlist of Show/Hide Elements: Odoo only offers hiding it while it is empty -->
<t t-inherit="website.HeaderElementsOption" t-inherit-mode="extension">
    <xpath expr="//BuilderButton[@title.translate='Search Bar']" position="after">
        <BuilderButton
            title.translate="Wishlist"
            className="'flex-grow-1'"
            icon="'favorite'"
            iconClass="'oi-filled'"
            actionParam="{ views: ['!theme_scita.header_hide_wishlist_link'] }"
        />
    </xpath>
</t>

<!-- Lazy Loading -->
<t t-inherit="website_sale.ProductsListPageOption" t-inherit-mode="extension">
    <xpath expr="//BuilderRow[@label.translate='Toolbar']" position="after">

        <!-- Product Loader Option -->
        <BuilderRow label.translate="Product Loader">
            <BuilderSelect action="'templatePreviewableWebsiteConfig'">

                <!-- Default Pager -->
                <BuilderSelectItem
                    title.translate="Default Pager"
                    id="'theme_scita.default_pager'"
                    actionParam="{
                        views: ['theme_scita.default_pager'],
                        previewClass: 'o_wsale_previewing_default_pager',
                        placeBefore: '#products_grid .o_wsale_products_grid_table_wrapper',
                        placeExcludeRootClosest: '#o_wsale_container',
                    }"
                >
                    Default
                </BuilderSelectItem>

                <!-- Lazy Load Button -->
                <BuilderSelectItem
                    title.translate="Lazy Load Button"
                    id="'theme_scita.lazy_load_button'"
                    actionParam="{
                        views: ['theme_scita.lazy_load_button'],
                        previewClass: 'o_wsale_previewing_lazy_button',
                        placeBefore: '#products_grid .o_wsale_products_grid_table_wrapper',
                        placeExcludeRootClosest: '#o_wsale_container',
                    }"
                >
                    Button
                </BuilderSelectItem>

            </BuilderSelect>
        </BuilderRow>

    </xpath>
</t>

 <t t-inherit="website.ThemeButtonOption" t-inherit-mode="extension" name="Add Custom Button and Hover Options">
        <xpath expr="//BuilderContext" position="inside">

            <!-- Button Style Option -->
            <BuilderRow label.translate="Buttons Style">
                <BuilderSelect action="'customizeWebsiteVariable'" actionParam="'btn-style-template'">
                    <BuilderSelectItem actionValue="'btn_style_1'">
                        <img src="/theme_scita/static/src/img/snippet_icon/Button-style1.svg"
                             alt="Button Style 1"/>
                        Style 1
                    </BuilderSelectItem>
                    <BuilderSelectItem actionValue="'btn_style_2'">
                        <img src="/theme_scita/static/src/img/snippet_icon/Button-style2.svg"
                             alt="Button Style 2"/>
                        Style 2
                    </BuilderSelectItem>
                    <BuilderSelectItem actionValue="'btn_style_3'">
                        <img src="/theme_scita/static/src/img/snippet_icon/Button-style3.svg"
                             alt="Button Style 3"/>
                        Style 3
                    </BuilderSelectItem>
                    <BuilderSelectItem actionValue="'btn_style_4'">
                        <img src="/theme_scita/static/src/img/snippet_icon/Button-style4.svg"
                             alt="Button Style 4"/>
                        Style 4
                    </BuilderSelectItem>
                </BuilderSelect>
            </BuilderRow>

            <!-- Product Hover Style Option -->
            <BuilderRow label.translate="Product Hover Style">
                <BuilderSelect action="'customizeWebsiteVariable'" actionParam="'prod-hover-style'">
                    <BuilderSelectItem actionValue="'prod_hover_style_1'">Effect Style 1</BuilderSelectItem>
                    <BuilderSelectItem actionValue="'prod_hover_style_2'">Effect Style 2</BuilderSelectItem>
                    <BuilderSelectItem actionValue="'prod_hover_style_3'">Effect Style 3</BuilderSelectItem>
                    <BuilderSelectItem actionValue="'prod_hover_style_4'">Effect Style 4</BuilderSelectItem>
                    <BuilderSelectItem actionValue="'prod_hover_style_5'">Effect Style 5</BuilderSelectItem>
                </BuilderSelect>
            </BuilderRow>

        </xpath>
    </t>
</templates>