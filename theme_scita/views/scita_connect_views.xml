<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="scita_connect_item_view_list" model="ir.ui.view">
        <field name="name">scita.connect.item.list</field>
        <field name="model">scita.connect.item</field>
        <field name="arch" type="xml">
            <list string="Quick Contact Cards">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="icon"/>
                <field name="url"/>
                <field name="website_id" groups="website.group_multi_website"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="scita_connect_item_view_form" model="ir.ui.view">
        <field name="name">scita.connect.item.form</field>
        <field name="model">scita.connect.item</field>
        <field name="arch" type="xml">
            <form string="Quick Contact Card">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Call Us"/>
                            <field name="description" placeholder="e.g. +1 555 0100"/>
                            <field name="icon"/>
                        </group>
                        <group>
                            <field name="url" placeholder="e.g. tel:+15550100"/>
                            <field name="new_window"/>
                            <field name="website_id" options="{'no_create': True}" groups="website.group_multi_website"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="scita_connect_item_action" model="ir.actions.act_window">
        <field name="name">Quick Contact Cards</field>
        <field name="res_model">scita.connect.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a card to the Quick Contact Panel</p>
            <p>Each card opens a link: a page, a phone number (tel:), an email address (mailto:) or a map.</p>
        </field>
    </record>

    <menuitem id="scita_connect_item_menu" name="Quick Contact Cards"
              parent="website.menu_website_global_configuration"
              action="scita_connect_item_action" sequence="60"/>

    <!-- Side tab + drawer, on every page of a website that has the feature on and at least one card -->
    <template id="scita_connect_drawer" inherit_id="website.layout" name="Scita Quick Contact Panel">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <t t-set="sct_connect_items" t-value="website and website._scita_connect_items()"/>
            <t t-if="sct_connect_items">
                <button type="button" class="o_scita_connect_tab css_editable_mode_hidden o_not_editable"
                        data-bs-toggle="offcanvas" data-bs-target="#o_scita_connect" aria-controls="o_scita_connect">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5A8 8 0 1 1 21 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/></svg>
                    <span t-out="website.scita_connect_title or 'Get in Touch'"/>
                </button>
                <div id="o_scita_connect" class="offcanvas offcanvas-end o_scita_connect css_editable_mode_hidden o_not_editable"
                     tabindex="-1" aria-labelledby="o_scita_connect_title">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="o_scita_connect_title" t-out="website.scita_connect_title or 'Get in Touch'"/>
                        <button type="button" class="o_scita_connect_close" data-bs-dismiss="offcanvas" aria-label="Close" title="Close">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                        </button>
                    </div>
                    <div class="offcanvas-body">
                        <a t-foreach="sct_connect_items" t-as="sct_item" t-att-href="sct_item.url"
                           t-att-target="sct_item.new_window and '_blank'" t-att-rel="sct_item.new_window and 'noopener'"
                           class="o_scita_connect_item">
                            <span class="o_scita_connect_icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <t t-if="sct_item.icon == 'quote'"><path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8z"/><path d="M14 3v5h5M8.5 13h7M8.5 16.5h4"/></t>
                                    <t t-elif="sct_item.icon == 'phone'"><path d="M21 16.4v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 2.6 5.2 2 2 0 0 1 4.6 3h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.6 10.9a16 16 0 0 0 4.5 4.5l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></t>
                                    <t t-elif="sct_item.icon == 'email'"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></t>
                                    <t t-elif="sct_item.icon == 'location'"><path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></t>
                                    <t t-elif="sct_item.icon == 'buy'"><path d="M5 7h14l-1.2 12.1A2 2 0 0 1 15.8 21H8.2a2 2 0 0 1-2-1.9z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/></t>
                                    <t t-elif="sct_item.icon == 'play'"><circle cx="12" cy="12" r="9"/><path d="m10 8.5 5 3.5-5 3.5z"/></t>
                                    <t t-elif="sct_item.icon == 'chat'"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5A8 8 0 1 1 21 12z"/></t>
                                    <t t-elif="sct_item.icon == 'whatsapp'"><path d="M20.5 12a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.2-4.3A8.5 8.5 0 1 1 20.5 12z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8a4.5 4.5 0 0 1-2.3-2.3l.8-1-1-2z"/></t>
                                    <t t-elif="sct_item.icon == 'calendar'"><rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/></t>
                                    <t t-else=""><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1"/></t>
                                </svg>
                            </span>
                            <span class="o_scita_connect_text">
                                <span class="o_scita_connect_name" t-out="sct_item.name"/>
                                <span t-if="sct_item.description" class="o_scita_connect_desc" t-out="sct_item.description"/>
                            </span>
                            <span class="o_scita_connect_arrow" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="m10 7 5 5-5 5"/></svg>
                            </span>
                        </a>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
