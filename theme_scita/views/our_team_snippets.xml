<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Experts details snippets -->
    <template id="it_our_team" name="Our Team Slider 1">
        <section class="it_our_team our_team_varient_1" contentEditable="false" data-name="Our Team Slider 1" data-disp="our_team">
            <div class="container">
                <div class='row sct_top_row'>
                    <div class="col-md-12">
                        <h2 class="section-title text-center mb-3">Our Awesome Team</h2>
                        <p class="sct_simple_text">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempo. Enim ad minim veniam Lorem ipsum dolor sit amet, consectetur adipisicing elit,</p>
                    </div>
                </div>
            </div>
            <div class='container our_team_1' id="it_our_team">
                <!-- the editor's sample of the slider (the team is loaded on the live page): the same
                     markup as it_our_team_view, sample members in a row instead of the carousel -->
                <div class="row sct_btm_row">
                    <div class="col-md-12">
                        <div class="sct_team_slider">
                            <div class="category-slider-placeholder sct-dyn-sample sct-team-sample-1">
                                <t t-foreach="[(1, 'Jeffrey Kelly', 'Consultant'), (2, 'Anita Oliver', 'Experienced Developer'), (3, 'Ethan Brooks', 'Marketing Manager'), (4, 'Toni Jimenez', 'Sales Executive')]" t-as="sct_m">
                                    <div class="item">
                                        <div class="image-container">
                                            <div class="only-image">
                                                <img class="img-responsive" t-attf-src="/theme_scita/static/src/img/sct_team_sample_#{sct_m[0]}.webp" alt="Team member" width="300" height="300" loading="lazy"/>
                                            </div>
                                            <div class="name">
                                                <h3 class="sct_title" t-out="sct_m[1]"/>
                                                <p class="sct_simple_text"><span t-out="sct_m[2]"/></p>
                                            </div>
                                            <div class="follow">
                                                <a href="#"><i class="fa fa-twitter"/></a>
                                        <a href="#"><i class="fa fa-facebook"/></a>
                                        <a href="#"><i class="fa fa-linkedin"/></a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="it_our_team_view" name="Our Team Variant 1"> 
        <div class='row sct_btm_row'>
            <div class='col-md-12'>
                <div class="sct_team_slider">
                    <div id="myourteam" class="owl-carousel myourteam owl-theme">
                        <t t-as="cust_employees" t-foreach="employee">
                            <div class="item">
                                <div class="image-container">
                                    <div class="only-image">
                                        <img class="img-responsive" t-att-src="website.image_url(cust_employees, 'image_1920')"/>
                                    </div>
                                    <div class="name">
                                        <h3 class='sct_title' t-out="cust_employees.name"/>
                                        <p class='sct_simple_text'>
                                            <span t-out="cust_employees.function"/>
                                        </p>
                                    </div>
                                    <div class="follow">
                                        <a t-att-href="'%s'%(cust_employees.emp_social_twitter)" t-if="cust_employees.emp_social_twitter">
                                            <i class="fa fa-twitter"/>
                                        </a>
                                        <a t-att-href="'%s'%(cust_employees.emp_social_facebook)" t-if="cust_employees.emp_social_facebook">
                                            <i class="fa fa-facebook"/>
                                        </a>
                                        <a t-att-href="'%s'%(cust_employees.emp_social_linkdin)" t-if="cust_employees.emp_social_linkdin">
                                            <i  class="fa fa-linkedin"/>
                                        </a>
                                    </div>
                                </div>     
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </template>
    <template id="our_team_varient_3" name="Our Team Slider 2">
        <section class="our_team_varient_3" contentEditable="false" data-name="Our Team Slider 2" data-disp="our_team">
            <div class="container">
                <div class='row sct_top_row'>
                    <div class="col-md-12">
                        <h2 class="section-title">Our Team</h2>
                        <p class="sct_simple_text">Lorem ipsum dolor sit amet</p>
                    </div>
                </div>
                <div class='row sct_btm_row'>
                    <div class='col-md-12'>
                        <div class="sct_team_slider our_team_3" id="our_team_varient_3">
                            <!-- the editor's sample (the team is loaded on the live page), as our_team_varient_3_view -->
                            <div class="category-slider-placeholder sct-dyn-sample sct-team-sample-3">
                                <t t-foreach="[(1, 'Jeffrey Kelly', 'Consultant'), (2, 'Anita Oliver', 'Experienced Developer'), (3, 'Ethan Brooks', 'Marketing Manager'), (4, 'Toni Jimenez', 'Sales Executive')]" t-as="sct_m">
                                    <div class="item">
                                        <div class="v-3-image-container">
                                            <div class="only-image">
                                                <img class="img-responsive" t-attf-src="/theme_scita/static/src/img/sct_team_sample_#{sct_m[0]}.webp" alt="Team member" width="300" height="300" loading="lazy"/>
                                            </div>
                                            <div class="name">
                                                <h3 class="sct_title" t-out="sct_m[1]"/>
                                                <h4 class="sct_job_desig"><span t-out="sct_m[2]"/></h4>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="our_team_varient_3_view" name="Our Team Variant 3">
        <div id="v_3_myourteam" class="owl-carousel myourteam owl-theme">
            <t t-as="cust_employees" t-foreach="employee">
                <div class="item">
                    <div class="v-3-image-container">
                        <div class="only-image">
                            <img class="img-responsive" t-att-src="website.image_url(cust_employees, 'image_1920')"/>
                        </div>
                        <div class="name">
                            <h3 class='sct_title' t-out="cust_employees.name"/>
                            <h4 class='sct_job_desig'>
                                <span t-out="cust_employees.function"/>
                            </h4>
                        </div>
                    </div>     
                </div>
            </t>
        </div>
    </template>
    <template id="our_team_varient_5" name="Our Team Slider 3">
        <section class="our_team_varient_5" contentEditable="false" data-name="Our Team Slider 3" data-disp="our_team">
            <div class="container">
                <div class='row sct_top_row'>
                    <div class="col-md-12">
                        <h2 class="section-title">Meet Our Team</h2>
                        <p class="sct_simple_text">Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
                    </div>
                </div>
                <div class='row sct_btm_row'>
                    <div class='col-md-12'>
                        <div class="sct_team_slider our_team_5" id="our_team_varient_5">
                            <!-- the editor's sample (the team is loaded on the live page), as our_team_varient_5_view -->
                            <div class="category-slider-placeholder sct-dyn-sample sct-team-sample-5">
                                <t t-foreach="[(1, 'Jeffrey Kelly', 'Consultant'), (2, 'Anita Oliver', 'Experienced Developer'), (3, 'Ethan Brooks', 'Marketing Manager'), (4, 'Toni Jimenez', 'Sales Executive')]" t-as="sct_m">
                                    <div class="item">
                                        <div class="v-5-image-container">
                                            <div class="only-image">
                                                <img class="img-responsive" t-attf-src="/theme_scita/static/src/img/sct_team_sample_#{sct_m[0]}.webp" alt="Team member" width="300" height="300" loading="lazy"/>
                                                <div class="user_content_hover_wrap">
                                                    <div class="sct_emp_desc">
                                                        <p class="sct_simple_text">Lorem Ipsum is simply dummy text of the printing and typesetting industry.</p>
                                                    </div>
                                                    <div class="sct_hover_follow">
                                                        <a href="#"><i class="fa fa-twitter"/></a>
                                        <a href="#"><i class="fa fa-facebook"/></a>
                                        <a href="#"><i class="fa fa-linkedin"/></a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="name">
                                                <h3 class="sct_title" t-out="sct_m[1]"/>
                                                <h4 class="sct_job_desig sct_blue_line"><span t-out="sct_m[2]"/></h4>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="our_team_varient_5_view" name="Our Team Variant 5">
        <div id="v_5_myourteam" class="owl-carousel myourteam owl-theme">
            <t t-as="cust_employees" t-foreach="employee">
                <div class="item">
                    <div class="v-5-image-container">
                        <div class="only-image">
                            <img class="img-responsive" t-att-src="website.image_url(cust_employees, 'image_1920')"/>
                            <div class="user_content_hover_wrap">
                                <div class='sct_emp_desc'>
                                    <p class='sct_simple_text' t-out="cust_employees.emp_description"/>
                                </div>
                                <div class="sct_hover_follow">
                                    <a t-att-href="'%s'%(cust_employees.emp_social_twitter)" t-if="cust_employees.emp_social_twitter">
                                        <i class="fa fa-twitter"/>
                                    </a>
                                    <a t-att-href="'%s'%(cust_employees.emp_social_facebook)" t-if="cust_employees.emp_social_facebook">
                                        <i class="fa fa-facebook"/>
                                    </a>
                                    <a t-att-href="'%s'%(cust_employees.emp_social_linkdin)" t-if="cust_employees.emp_social_linkdin">
                                        <i  class="fa fa-linkedin"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="name">
                            <h3 class='sct_title' t-out="cust_employees.name"/>
                            <h4 class='sct_job_desig sct_blue_line'>
                                <span t-out="cust_employees.function"/>
                            </h4>
                        </div>
                    </div>     
                </div>
            </t>
        </div>
    </template>
</odoo>