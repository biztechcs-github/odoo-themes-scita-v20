<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_bulk_price_btn" inherit_id="website_sale.cta_wrapper">
        <!-- comment the code for not develop the feature yet -->
        <!-- <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <p class="promo_code mt-3"><i class="lni lni-badge-decagram-percent"></i>Apply the code <span class="discount_code">'GET15OFF'</span> to receive your discount.</p>
        </xpath> -->
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="before">
        <t t-set="pricelist" t-value="(website_sale_order and website_sale_order.pricelist_id) or request.pricelist"/>
        <t t-if="pricelist">
            <!-- Bulk tiers: rules for this template/variant with min_quantity >= 2 -->
            <!-- unit price at each tier quantity, whatever the rule type (fixed, %, formula) -->
            <t t-set="rules" t-value="product._scita_bulk_prices(product_variant, pricelist)"/>

            <!-- Hidden with the price: request quote, prices hidden on the website, or
                 "login to see price" for visitors (the tier prices are prices too) -->
            <t t-set="sct_bulk_hide_price" t-value="not website.website_show_price or product.website_hide_price or website.website_hide_price or (website.login_see_price and request.env.user._is_public())"/>
            <!-- Always render container so JS can show/hide on variant change -->
            <div id="o_bulk_price_section" t-attf-class="{{'d-none' if (not rules or sct_bulk_hide_price) else ''}}">
                <h5 class="mt-3 mb-2">Big savings with bulk buys</h5>
                <div class="d-flex flex-wrap gap-2 o_bulk_price_wrapper" t-if="not sct_bulk_hide_price">
                    <t t-foreach="rules" t-as="rule">
                        <a class="btn btn-outline-primary o_bulk_price_btn"
                           t-att-qty="rule['min_quantity']"
                           t-att-price="rule['fixed_price']"
                           href="#">
                            <span class="buy-tag">Buy
                            <t t-out="rule['min_quantity']"/></span>
                            at
                            <span class="buy-price"><t t-out="'%.2f' % rule['fixed_price']"/></span>
                            / Unit
                        </a>
                    </t>
                </div>
            </div>
        </t>
        </xpath>
    </template>
</odoo>
