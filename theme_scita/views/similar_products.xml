<!-- similar product -->
<odoo>
    <record id="view_product_form_similar" model="ir.ui.view">
        <field name="name">product.template.similar.products</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Similar Products">
                    <field name="similar_product_ids" 
                        widget="many2many_tags" 
                        options="{'no_create': True}"
                        placeholder="Select products that are similar to this one for suggestions on the website."/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product page: button and sidebar of static/src/js/similar_products_sidebar.js, for a
         product with similar products the visitor can see (as /get_similar_products lists them) -->
    <template id="product_similar_products_sidebar" inherit_id="website_sale.product" name="Similar Products Sidebar">
        <xpath expr="//t[@t-call='website.layout']" position="before">
            <t t-set="sct_has_similar_products" t-value="bool(product.similar_product_ids._scita_on_website().filtered('is_published'))"/>
        </xpath>
        <xpath expr="//t[@t-call='website_sale.cta_wrapper']" position="after">
            <button t-if="sct_has_similar_products" type="button" class="btn btn-link px-0 mb-3 btn-similar-products" t-att-data-product-template-id="product.id">
                <i class="lni lni-layers-1 me-2" role="presentation"/>Similar Products
            </button>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="inside">
            <div t-if="sct_has_similar_products" id="similar-product-sidebar" class="similar-side-menu o_hidden">
                <div class="similar-sidebar-header">
                    <h5>Similar Products</h5>
                    <button type="button" id="close-similar-sidebar" aria-label="Close">&#215;</button>
                </div>
                <div id="similar-products-list"/>
            </div>
        </xpath>
    </template>
</odoo>
