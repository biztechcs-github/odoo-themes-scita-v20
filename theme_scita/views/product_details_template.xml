    <template id="scita_tax_indication" inherit_id="website_sale.tax_indication">
        <xpath expr='//small[@t-if]' position='attributes'>
            <attribute name='class'>sct_vat</attribute>
        </xpath>
        <xpath expr='//small[@t-else=""]' position='attributes'>
            <attribute name='class'>sct_vat</attribute>
        </xpath>
    </template>
    <template id="custom_product_tags_inline_display" inherit_id="website_sale.product_title">
        <xpath expr="//t[@t-call='website_sale.product_tags']" position="replace"/>
            
        <xpath expr="//h1" position="replace">
            <section class="page-title">
                <div class="container mx-auto">
                    <div>
                        <ul class="breadcrumb">
                            <li>
                                <a href="/">Home</a>
                            </li>
                            <li>
                                <a href="/shop">Products</a>
                            </li>
                            <li t-if="category">
                                <a t-att-href="keep('/shop/category/%s' % slug(category), category=0)" t-field="category.name"/>
                            </li>
                            <li class="active">
                                <a class="prod_link" t-field="product.name"/>
                            </li>
                        </ul>
                    </div>
                    <div class="sct-next-prev-prod">
                        <div class='sct-btn-wrap'>
                            <a t-att-href="'/shop/%s' % prev_product" t-att-class="'sct_prev_text' if prev_product else 'sct_prev_text disable'">prev</a>
                        </div>
                        <div class='sct-btn-wrap'>
                            <a t-att-href="'/shop/%s' % next_product" t-att-class="'sct_next_text' if next_product else 'sct_next_text disable'">next</a>
                        </div>
                    </div>
                </div>
            </section>
            <h1 class='sct-prod-name' itemprop="name" t-field="product.name">Product Name</h1>
            <div class='sct-sku-display-div'>
                <p class='sct-sku-display'>SKU: <span class='sct-default-code' t-out='product.default_code'/>
                </p>
            </div>
            <!-- <div class='sct-main-description-div' t-if="product.description_sale">
                <p t-field="product.description_sale" class="text-muted" placeholder="A short description that will also appear on documents." />
            </div> -->
        </xpath>
    </template>
    <template id="product_details_sku_change_as_per_variant" inherit_id="theme_scita.custom_product_tags_inline_display" name="Product Info">
        <xpath expr="//div[hasclass('sct-sku-display-div')]" position="replace">
            <!-- Settings > "Display product reference" (per website), the reference of the variant
                 shown; product_details.js follows variant changes -->
            <t t-set="sct_sku" t-value="(product_variant or product).default_code"/>
            <div class='sct-sku-display-div' t-att-data-show="'1' if website.is_default_code else '0'">
                <t t-if='sct_sku and website.is_default_code'>
                    <p class='sct-sku-display'>SKU: <span class='sct-default-code' t-out='sct_sku'/>
                    </p>
                </t>
            </div>
        </xpath>
    </template>
    <template id="hide_product_breadcrumb" inherit_id="website_sale.product" name="Hide Breadcrumb on Product Page">
        <xpath expr="//ol[hasclass('o_wsale_breadcrumb')]" position="attributes">
            <attribute name="t-attf-style">display:none;</attribute>
        </xpath>
    </template>
    <template id="product_detail_custom_class" inherit_id="website_sale.product" priority="20">
        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute name='class' add="container" separator=" "/>
        </xpath>
    </template>

    <!-- Hide base Odoo 19 Customer Reviews section -->
    <template id="hide_base_review_section" inherit_id="website_sale.product_comment" name="Hide Base Review Section (Scita)" priority="99">
        <!-- Remove the entire base Customer Reviews section -->
        <xpath expr="//div[hasclass('o_shop_discussion_rating')]" position="replace"/>
    </template>

    <!-- Add custom Reviews tab after Description tab -->
    <template id="theme_scita_rating_19" inherit_id="theme_scita.theme_scita_product_details" name="Scita Reviews Tab (Odoo 19)" active="True" customize_show="True" priority="15">
        <!-- Add Reviews tab -->
        <xpath expr="//div[@id='website_description']/div/ul/li" position="after">
            <li role="presentation" t-if="is_view_active('website_sale.product_comment')">
                <a aria-controls="reviews" data-bs-toggle="tab" href="#reviews" role="tab">
                    Reviews
                    <!-- Odoo 20 dropped website_message_ids; use the review count Odoo shows next to the stars -->
                    <t t-if="product.rating_count">
                        <span class="review_label">
                            (<t t-out="product.rating_count"/>)
                        </span>
                    </t>
                </a>
            </li>
        </xpath>
        <!-- Add Reviews tab content -->
        <xpath expr="//div[@id='website_description']//div[@id='description']" position="after">
            <t t-if="is_view_active('website_sale.product_comment')">
                <div class="tab-pane" id="reviews" role="tabpanel">
                    <!-- id: Odoo's links to the reviews ("N reviews", review emails) target it -->
                    <div class="container" id="o_product_page_reviews">
                        <!-- <h3 class="mb-3">Customer Reviews</h3> -->
                        <t t-call="portal.message_thread" object="product" display_rating="True" message_per_page="5" two_columns="True">
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="scita_description" inherit_id="portal_rating.rating_widget_stars_static">
        <xpath expr="//div[hasclass('o_website_rating_static')]" position="after">
          <div class='sct-main-description-div' t-if="product.description_sale and not is_quick_view">
                <p t-field="product.description_sale" class="text-muted" placeholder="A short description that will also appear on documents." />
           </div>
           </xpath>
    </template>
    <template id="add_container_class_to_product_detail" inherit_id="website_sale.product" name="Add Container Class to Product Detail Section">
        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute name="class" remove="container-lg" separator=" "/>
        </xpath>
    </template>
        <template id="scita_tag"
            inherit_id="theme_scita.product_terms_and_conditions"
            name="Add Product Tags After Terms  Conditions">

        <!-- Target the <small> inside your terms template -->
        <xpath expr="//small" position="before">
            <t t-if="is_view_active('website_sale.product_tags')">
                <t t-if="product_variant.all_product_tag_ids">
                    <p class="mt-2">
                        <strong>Tags:</strong>
                        <t t-set="tag_len" t-value="len(product_variant.all_product_tag_ids)"/>
                        <t t-foreach="enumerate(product_variant.all_product_tag_ids)" t-as="tag_item">
                            <t t-set="i" t-value="tag_item[0]"/>
                            <t t-set="tag" t-value="tag_item[1]"/>
                            <t t-out="tag.name"/>
                            <t t-if="i + 1 &lt; tag_len">, </t>
                        </t>
                    </p>
                </t>
            </t>
        </xpath>
    </template>
    <!-- Settings > "Brand display in product page": the product's Scita brand under its tags, as its
         logo or its name (the name when the brand has no logo), linking to the shop of that brand -->
    <template id="product_details_brand_display" inherit_id="theme_scita.scita_tag" name="Product Brand">
        <xpath expr="//small" position="before">
            <t t-set="sct_brand" t-value="website.is_brand_display and product.product_brand_id"/>
            <div t-if="sct_brand" class="sct-brand-display mt-2 mb-2">
                <a t-attf-href="/shop?brand={{sct_brand.id}}" t-att-title="sct_brand.name">
                    <img t-if="website.brand_display_option == 'logo' and sct_brand.image" class="sct-brand-logo img-fluid"
                         style="max-height: 40px;" t-att-src="website.image_url(sct_brand, 'image')" t-att-alt="sct_brand.name"/>
                    <span t-else="" class="sct-brand-name">Brand: <t t-out="sct_brand.name"/></span>
                </a>
            </div>
        </xpath>
    </template>
    <template id="theme_scita_remove_empty_price_section"
            inherit_id="website_sale.product"
            name="Remove Empty Price Section in Product Page">

    <xpath expr="//div[hasclass('o_wsale_product_details_content_section_price')]" position="replace"/>
