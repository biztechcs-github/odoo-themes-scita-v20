<xpath expr="//we-button[@data-customize-website-views='website_sale.product_add_to_compare']" position="replace">
<we-button title="Compare" class="fa fa-fw fa-exchange" data-customize-website-views="theme_scita.product_add_to_compare" data-no-preview="true" data-reload="/"/>
