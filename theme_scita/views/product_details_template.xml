<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi image feature for products -->
    <template id="scita_shop_product_carousel" inherit_id="website_sale.shop_product_carousel" name="Scita Shop product carousel">
        <xpath expr='//div[@id="o-carousel-product"]' position='attributes'>
            <attribute name="class" remove="position-sticky" separator=" "></attribute>
        </xpath>
    </template>
    <!-- <template id="theme_scita_product_details" inherit_id="base.contact" name="Product Details">
        <xpath expr="//div[@itemscope='itemscope']" position="replace"/>
    </template> -->
    <template id="theme_scita_product_details" inherit_id="website_sale.product" name="Product Details">
        <xpath expr="//div[@id='product_details']//t[@t-call='website_sale.product_price']" position="replace"/>
        <xpath expr="//div[@id='product_full_description']" position="replace">
            <section class='sct-description-tab'>
                <div class="container" id="website_description">
                    <div class="pd-more-info">
                        <ul class="nav nav-tabs" id="description_reviews_tabs" role="tablist">
                            <li class="" role="presentation">
                                <a aria-controls="more_info" class="active show" data-bs-toggle="tab" href="#description" role="tab">Description</a>
                            </li>
                        </ul>
                        <div class="tab-content" id="description_reviews_tabs_contents">
                            <div class="tab-pane active" id="description" role="tabpanel">
                                <div itemprop="description" t-field="product.website_description" class="oe_structure oe_empty mt16" id="product_full_description"/>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

        <!-- <xpath expr="//a[@id='add_to_cart']" position="attributes">
<attribute name="class">btn btn-lg js_check_product a-submit</attribute>
</xpath> -->
        <!-- <xpath expr="//div[@id='product_details']" position="attributes">
            <attribute name="class">col-md-7</attribute>
        </xpath> -->
    </template>
    <!-- Odoo 20 removed website_sale.product_terms_and_conditions; Scita keeps its own copy -->
    <template id="product_terms_and_conditions" name="Terms and Conditions">
        <small class="text-muted mb-0">
            <a href="/terms" class="o_translate_inline text-muted"><u>Terms and Conditions</u></a><br/>
            30-day money-back guarantee<br/>
            Shipping: 2-3 Business Days
        </small>
    </template>
    <template id="product_terms_and_conditions_hook" inherit_id="website_sale.product" name="Scita Product Terms and Conditions Hook">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="inside">
            <t t-if="is_view_active('theme_scita.product_terms_and_conditions')" t-call="theme_scita.product_terms_and_conditions"/>
        </xpath>
    </template>
    <!-- Never in effect: the same id was defined again in request_quote_custom_templates.xml and
         hide_price_configurations.xml, which load later and replaced it (also in 19). Those copies
         only added the Request Quote pop-up, now added once in website.layout, so this one is kept
         disabled to leave the product page unchanged.
    <template id="theme_scita_product_details_terms_and_share" inherit_id="theme_scita.product_terms_and_conditions" name="Product Details Terms and Share">
        <xpath expr="//small[hasclass('text-muted','mb-0')]" position="before">
            <t t-if="product.product_brand_id">
                <img class="brand_img" style="max-height: 50px;" t-att-src="website.image_url(product.product_brand_id, 'image')"/>
            </t>
        </xpath>
        <!~~ Add id attribute to small tag ~~>
        <xpath expr="//small[hasclass('text-muted','mb-0')]" position="attributes">
            <attribute name="id">o_product_terms_and_share</attribute>
        </xpath>

        <!~~ <xpath expr="//div[@id='o_product_terms_and_share']" position='attributes'>
<attribute name='class'>d-flex justify-content-between flex-column flex-md-row mb-3</attribute>
</xpath> ~~>
    </template>
    -->
    <template id="theme_scita_product_details_add_to_cart" inherit_id="website_sale.cta_wrapper" name="Product Details Add to Cart">
        <!-- Odoo 20: add to cart is button[name=add_to_cart] driven by core JS; keep Scita's wrapper and look around it -->
        <xpath expr="//button[@name='add_to_cart'][@data-action='add_to_cart']" position="replace">
            <div class='sct-main-price-description'>
                <!-- Scita's Add to wishlist / Compare are added in here too: only the cart button
                     depends on the product being sellable, so they stay on sold-out / Contact Us pages -->
                <div class='sct-price-option'>
                    <!-- Always rendered: Odoo 20 reads the product ids from this button on every
                         variant change (a product that can't be sold, e.g. priced 0 with "Prevent
                         sale of zero priced products", sent no product and the server failed).
                         While the variant can't be sold, core puts .d-none on #add_to_cart_wrap and
                         product_cta_layout.scss hides this block; Scita's "Hide Add Cart Button"
                         (visitors) hides the button itself. -->
                    <div class="sct-add-to-cart-mob">
                        <t t-set="sct_cart_btn_hidden" t-value="website.add_to_cart and request.env.user._is_public()"/>
                        <button
                            name="add_to_cart"
                            type="button"
                            id="add_to_cart"
                            t-attf-class="btn btn-primary btn-lg mt16 js_check_product a-submit #{'d-none' if sct_cart_btn_hidden else 'd-block d-sm-inline-block'}"
                            data-action="add_to_cart"
                            data-animation-selector=".o_wsale_product_images"
                            t-att-data-product-category-id="product.public_categ_ids.ids and product.public_categ_ids.ids[0]"
                            t-att-data-product-id="product_variant.id"
                            t-att-data-product-template-id="product.id"
                            t-att-data-product-type="product.type"
                            t-att-data-show-quantity="is_view_active('website_sale.product_quantity') or is_view_active('theme_scita.theme_scita_product_quantity')"
                        >
                            <i class="lni lni-cart-1"></i> Add to Cart</button>
                    </div>
                </div>
            </div>
            <div class='sct-other-desciption'></div>
        </xpath>
    </template>
    <!-- Scita's quantity selector on the product page. Scita turns Odoo's own one
         (website_sale.product_quantity) off when the theme is applied, which left the product page
         without a quantity box and the cart lines without their -/+ buttons. This one shows instead,
         with Odoo's markup (Odoo's script runs the -/+ buttons, Scita's styles apply); when Odoo's
         "Quantity" option is turned on again in the editor, only Odoo's is shown. Not on websites
         without Scita, nor for the products whose price is hidden (as hide_PDP_quantity_template). -->
    <template id="theme_scita_product_quantity" inherit_id="website_sale.cta_wrapper" name="Scita Select Quantity">
        <div id="add_to_cart_wrap" position="inside">
            <t t-if="website and website._scita_theme_active() and not is_view_active('website_sale.product_quantity')
                      and not (not website.website_show_price or product.website_hide_price
                               or (website.login_see_price and request.env.user._is_public()))">
                <div t-attf-class="css_quantity sct-product-quantity input-group {{'d-none' if combination_info['prevent_sale'] else 'd-inline-flex order-first'}} align-middle border"
                     contenteditable="false">
                    <t t-set="minus_button_title"><t t-if="combination_info.get('minimum_qty_reached_message')" t-out="combination_info['minimum_qty_reached_message']"/><t t-else="">Remove one</t></t>
                    <button name="minus_button" class="btn btn-link pe-2 border-0"
                            t-att-aria-label="minus_button_title" t-att-title="minus_button_title"
                            t-att-data-min-qty-message="combination_info.get('minimum_qty_reached_message')">
                        <i class="oi text-600" data-icon="remove"/>
                    </button>
                    <t t-set="minimum_qty" t-value="combination_info.get('minimum_qty') or 1"/>
                    <input type="text" class="form-control quantity text-center border-0"
                           t-att-data-min="minimum_qty" name="add_qty" t-att-value="minimum_qty" aria-label="Quantity"/>
                    <button class="btn btn-link ps-2 border-0" aria-label="Add one" title="Add one">
                        <i class="oi text-600" data-icon="add"/>
                    </button>
                </div>
            </t>
        </div>
    </template>

    <!-- Contact Us (product that can't be sold online) in Add to Cart's place: the envelope used
         for Contact Us everywhere in Scita, as Add to Cart shows the cart -->
    <template id="theme_scita_contact_us_icon" inherit_id="website_sale.cta_wrapper" name="Product Details Contact Us icon">
        <xpath expr="//div[@id='contact_us_wrapper']/a" position="inside">
            <i class="sct-icon-mail" role="presentation"/>
        </xpath>
        <!-- prices hidden by Scita: its Login to see price / Request Quote button stands instead
             (a class, not d-none: core toggles d-none / d-flex on every variant change) -->
        <xpath expr="//div[@id='contact_us_wrapper']" position="attributes">
            <attribute name="t-att-data-sct-price-hidden">'1' if (website and (not website.website_show_price or product.website_hide_price or (website.login_see_price and request.env.user._is_public()))) else None</attribute>
        </xpath>
    </template>
    <template id="theme_scita_stock_notification_in_cta" inherit_id="website_sale.cta_wrapper" name="Product Details Notify me form in the CTA row">
        <!-- Scita's zip checker lives in the CTA row: keep the "Notify me" e-mail form right
             under its button instead of below the zip checker (as Odoo's boxed layouts do) -->
        <div id="out_of_stock_buttons_wrapper" position="after">
            <div id="stock_notification_wrapper" position="move"/>
        </div>
    </template>
    <template id="theme_scita_price" inherit_id="theme_scita.theme_scita_product_details_add_to_cart" name="Product Details Price (non-boxed CTA only)">
        <!-- Boxed purchase style already shows price in the CTA header (with "Price" label). -->
        <xpath expr="//div[hasclass('sct-price-option')]" position="before">
            <t t-if="website and not website.is_view_active('website_sale.cta_wrapper_boxed')">
                <t t-call="website_sale.product_price"/>
            </t>
        </xpath>
    </template>

    <!-- Discussion inherited to display in tabs -->
    <template id="theme_scita_rating" inherit_id="theme_scita.theme_scita_product_details">
        <xpath expr="//div[@id='website_description']/div/ul/li" position="after">
        </xpath>
    </template>
    <!-- template -->
    <template active="True" customize_show="True" id="theme_scita_zipcode_menu" inherit_id="theme_scita.theme_scita_product_details_add_to_cart" name="Zip Code Checker" priority="18">
        <xpath expr="//div[hasclass('sct-other-desciption')]" position="inside">
            <div class="sct_zip_div">
                <h4 class='sct_deliever_msg'>
                    <strong class="deliver">
                        <!-- "fa-truck" typed without the base "fa" class drew an empty box -->
                        <t t-set="sct_delivery_icon" t-value="res_company.delivery_icon and res_company.delivery_icon.strip()"/>
                        <i t-if="sct_delivery_icon" t-att-class="('fa ' + sct_delivery_icon) if sct_delivery_icon.startswith('fa-') else sct_delivery_icon"></i>
                        <t t-out="res_company.delivery_text"/>
                    </strong>
                </h4>
                <div class='sct_input_btn' t-if="res_company">
                    <input type="text" class="form-control value-zip" name="zipcode" placeholder="Zip Code"/>
                    <a role="button" id="check" class="btn checker">
                        <t t-out="res_company.delivery_btn_name"/>
                    </a>
                    <div class="get_status">
                        <span id='fail_msg' t-if="res_company.delivery_fail_msg" class='o_hidden'>
                            <t t-out="res_company.delivery_fail_msg" />
                        </span>
                        <span id='success_msg' t-if="res_company.delivery_success_msg" class='o_hidden'>
                            <t t-out="res_company.delivery_success_msg"/>
                        </span>
                        <span id='blank_msg' t-if="res_company.delivery_blank_msg" class='o_hidden'>
                            <t t-out="res_company.delivery_blank_msg"/>
                        </span>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="scita_ecom_show_extra_fields" inherit_id="theme_scita.theme_scita_product_details" active="False" customize_show="True" name="Show Extra Fields">
        <xpath expr="//div[@id='website_description']/div/ul" position="inside">
            <li role="presentation">
                <a aria-controls="extra_fields" data-bs-toggle="tab" href="#sct_extra_fields" role="tab">Extra Details
                </a>
            </li>
        </xpath>
        <xpath expr="//div[@id='website_description']//div[@id='description']" position="after">
            <div class="tab-pane" id="sct_extra_fields" role="tabpanel">
                <section class="container">
                    <div class='row'>
                        <div class='col-lg-8' id='main_extra_fields'>
                            <table class='table table-striped table-sm table-hover'>
                                <tr t-foreach='website.shop_extra_field_ids' t-as='field' t-if='product[field.name]'>
                                    <td class='sct_extra_label'>
                                        <t t-out='field.label'/>
                                    </td>
                                    <t t-if='field.field_id.ttype != "binary"'>
                                        <td class='sct_extra_value' t-out='product[field.name]' t-options="{'widget': field.field_id.ttype}"/>
                                    </t>
                                    <t t-else=''>
                                        <td class='sct_extra_value'>
                                            <a target='_blank' t-attf-href='/web/content/product.template/#{product.id}/#{field.name}?download=1'>
                                                <i class='fa fa-file'></i>
                                            </a>
                                        </td>
                                    </t>
                                </tr>
                            </table>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
    <template id="theme_scita_fix_variant_attribute_class" inherit_id="website_sale.variants" name="Fix Variant Display for Theme Scita">
        <xpath expr="//li[@name='variant_attribute']" position="attributes">
            <!-- one line: QWeb's #{...} format does not match across a newline, so a wrapped
                 expression was printed as text and single-value attributes were never hidden -->
            <attribute name="t-attf-class">variant_attribute #{'d-none' if single and not ptavs[0].is_custom and attribute.display_type != 'multi' else ''} sct-#{attribute.display_type}</attribute>
        </xpath>
    </template>

    <template id="scita_products_add_to_cart" inherit_id="website_sale.shop_product_buttons">
        <xpath expr="//t[@t-if='product._website_show_quick_add()']//button" position="attributes">
            <attribute name="class">btn a-submit</attribute>
            <attribute name="t-if">not request.env.user._is_public() and website.add_to_cart or not website.add_to_cart</attribute>
        </xpath>
        <!-- Odoo 20 ships its own label; swap it for Scita's (descendant axes: in translation
             mode Odoo wraps translated terms in <span data-oe-translation-...>) -->
        <xpath expr="//button[@name='add_to_cart']//span[hasclass('o_label')]" position="replace">
            <span class="add_to_cart_text">Add to cart</span>
        </xpath>
        <xpath expr="//button[@name='add_to_cart']//i" position="attributes">
            <attribute name='class'>lni lni-cart-1</attribute>
        </xpath>
        <!-- Contact Us (product that can't be sold online) in Add to Cart's place: drawn like it,
             with the envelope used for Contact Us everywhere in Scita -->
        <xpath expr="//t[contains(@t-elif, '_prevent_product_sale')]/a" position="attributes">
            <attribute name="class">btn a-submit sct-contact-us-btn</attribute>
            <!-- prices hidden by Scita (login to see price, hidden prices, Request Quote): Scita's
                 own action stands for the product, as on every other card -->
            <attribute name="t-if">not (website and (not website.website_show_price or product.website_hide_price or (website.login_see_price and request.env.user._is_public())))</attribute>
        </xpath>
        <xpath expr="//t[contains(@t-elif, '_prevent_product_sale')]/a//span[hasclass('o_label')]" position="replace">
            <span class="add_to_cart_text">Contact Us</span>
        </xpath>
        <xpath expr="//t[contains(@t-elif, '_prevent_product_sale')]/a//i" position="attributes">
            <attribute name="class">lni lni-envelope-1</attribute>
        </xpath>
    </template>
    <!-- Scita's wishlist / compare buttons are the default (the theme disables Odoo's on install,
         see theme_custom.py). When Odoo's own button is enabled from the editor ("Actions"), it
         takes over and Scita's matching button is not rendered, so the two never show together. -->
    <template id="product_add_to_compare" inherit_id="theme_scita.theme_scita_product_details_add_to_cart" name="Add to comparison in product page">
        <xpath expr="//div[hasclass('sct-add-to-cart-mob')]" position="after">
            <t t-set="product_variant" t-value="product_variant or product._create_first_product_variant()"/>
            <a aria-label="Compare" class="btn btn-xs o_add_compare o_add_compare_dyn" data-action="o_comparelist" role="button" t-att-data-product-product-id="product_variant.id" t-att-data-product-id="product_variant.id" t-att-data-product-template-id="product.id" t-if="product_variant and not is_view_active('website_sale.product_add_to_compare')" title="Compare" type="button">
                <span class="fa fa-exchange"/>
                <span class='sct_icon_text'>Compare</span>
            </a>
        </xpath>
    </template>
    <template id="scita_product_add_to_wishlist" inherit_id="theme_scita.theme_scita_product_details_add_to_cart" name="Add to wishlist in product page" priority="20">
        <xpath expr="//div[hasclass('sct-add-to-cart-mob')]" position="after">
            <t t-set="product_variant" t-value="product_variant or product._create_first_product_variant()"/>
            <t t-set="in_wish" t-value="product_variant and product_variant._is_in_wishlist()"/>
            <button t-if="product_variant and product.type != 'combo' and not is_view_active('website_sale.product_add_to_wishlist')" type="button" role="button" class="btn btn-link px-0 pe-3 o_add_wishlist_dyn" t-att-disabled="in_wish" t-att-data-product-template-id="product.id" t-att-data-product-product-id="product_variant.id" data-action="o_wishlist" title="Add to wishlist">
                <i class="lni lni-heart me-2" role="img" aria-label="Add to wishlist"/>
Add to wishlist
            </button>
        </xpath>
    </template>
    <template id="scita_cart" inherit_id="website_sale.cart" name="Shopping Cart">
        <xpath expr="//div[@id='shop_cart']/t[@t-call='website_sale.cart_lines']" position="replace">
            <div class="sct-shop-cart custom_scroller">
                <t t-call="website_sale.cart_lines"/>
            </div>
        </xpath>
    </template>
    <template id="scita_product_description_table" inherit_id="theme_scita.theme_scita_product_details" active="False" name="Specification Inside Tab">
        <xpath expr="//div[@id='website_description']/div/ul/li" position="after">
            <li role="presentation">
                <a aria-controls="reviews" data-bs-toggle="tab" href="#specification" role="tab">Specification 
                </a>
            </li>
        </xpath>
        <xpath expr="//div[@id='website_description']//div[@id='description']" position="after">
            <div class="tab-pane" id="specification" role="tabpanel">
                <section id="product_full_spec">
                    <div class="container">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h3 class="m-0">Specifications</h3>
                        </div>
                        <div id="product_specifications">
                            <div class="row">
                                <t t-set="categories" t-value="product.valid_product_template_attribute_line_ids._prepare_categories_for_display()"/>
                                <t t-foreach="categories" t-as="category">
                                    <div class="col-lg-6">
                                        <table class="table">
                                            <t t-if="len(categories) > 1">
                                                <tr>
                                                    <th class="text-start" t-att-colspan="2">
                                                        <span t-if="category" t-field="category.name"/>
                                                        <span t-else="">Uncategorized</span>
                                                    </th>
                                                </tr>
                                            </t>
                                            <tr t-foreach="categories[category].filtered(lambda l: len(l.value_ids) > 1)" t-as="ptal">
                                                <td class="w-25">
                                                    <span t-field="ptal.attribute_id.name"/>
                                                </td>
                                                <td class="w-75 text-muted">
                                                    <t t-foreach="ptal.value_ids" t-as="pav">
                                                        <span t-field="pav.name"/>
                                                        <t t-if="not pav_last"> or</t>
                                                    </t>
                                                </td>
                                            </tr>
                                            <t t-set="single_value_attributes" t-value="categories[category]._prepare_single_value_for_display()"/>
                                            <tr t-foreach="single_value_attributes" t-as="attribute">
                                                <td class="w-25">
                                                    <span t-field="attribute.name"/>
                                                </td>
                                                <td class="w-75 text-muted">
                                                    <t t-foreach="single_value_attributes[attribute]" t-as="ptal">
                                                        <span t-field="ptal.product_template_value_ids._only_active().name"/>
                                                        <t t-if="not ptal_last">, </t>
                                                    </t>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </t>
                                <t t-if="is_view_active('website_sale.product_tags')">
                                    <div class="col-lg-6">
                                        <table class="table">
                                            <t t-if="product.product_variant_ids.all_product_tag_ids">
                                                <tr>
                                                    <th class="text-start" t-att-colspan="2">
                                                        <span>Tags</span>
                                                    </th>
                                                </tr>
                                                <tr class="d-flex">
                                                    <td class="w-25 d-flex align-items-center">
                                                        <span>Tags</span>
                                                    </td>
                                                    <td class="w-75 text-muted">
                                                        <t t-call="website_sale.product_tags" all_product_tags="product.product_variant_ids.all_product_tag_ids">
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </table>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
