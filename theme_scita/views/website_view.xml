<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="theme_scita_product_public_category" model="ir.ui.view">
        <field name="name">product.public.category</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id']" position="after">
                <field name="include_in_allcategory"/>
                <field name="include_in_megamenu"/>
                <field invisible="include_in_megamenu == False" required="include_in_megamenu == True" domain="[('is_megamenu', '=', True), ('megamenu_view_type', 'in', ['cat_megamenu','cat_img_megamenu'])]" name="menu_id"/>
                <field name="description" invisible="include_in_megamenu == False"/>
                <field invisible="1" name="linked_product_count"/>
                <field name="attributes_ids" widget="many2many_tags"/>
                <field name="attributes_ids_values" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
        <!-- Website Menu Form view -->
        <record id="website.website_menus_form_view" model="ir.ui.view">
            <field name="name">Website Menu Form View Inherited</field>
            <field name="model">website.menu</field>
            <!-- <field name="field_parent">child_id</field> -->
            <field name="arch" type="xml">
                <form string="Website menu">
                    <sheet>
                        <group>
                            <field name="website_id" options="{'no_create': True}"/>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="new_window"/>
                            <field name="parent_id"/>
                            <field name="is_service_menu" invisible='1'/>
                            <field name="parent_megamenu_view_type" invisible='1'/>
                        </group>
                        <group invisible="parent_id == False or is_megamenu == True">
                            <label for='is_mega_menu' string='Odoo Megamenu?'/>
                            <field name="is_mega_menu" nolabel="1"/>
                        </group>
                        <group invisible="parent_id == False or is_mega_menu == True">
                            <label for='is_megamenu' string='Scita Megamenu?'/>
                            <field name="is_megamenu" nolabel="1"/>
                        </group>
                        <group invisible="is_megamenu == False">
                            <field name="megamenu_view_type"/>
                        </group>
                        <notebook>
                            <page string="General Settings" invisible="is_megamenu == False or is_service_menu == True">
                              <group>
                                <field name="megamenu_type" widget="radio"
                                    invisible="megamenu_view_type in ('service_banner_megamenu','cat_img_megamenu','prod_megamenu','service_content_megamenu','service_page_megamenu')"/>
                                <field name="megamenu_type1" widget="radio" invisible="megamenu_view_type not in ('service_page_megamenu')"/>
                                
                                <field name="category_slider" invisible="megamenu_view_type not in ('cat_megamenu') or img_grid == True"/>
                                <field name="carousel_header_name"
                                       invisible="category_slider == False or megamenu_view_type != 'cat_megamenu'"/>
                                <field name="img_grid" invisible="megamenu_view_type not in ('cat_megamenu') or category_slider == True"/>
                                <field name="category_slider_position"
                                       invisible="category_slider == False and img_grid == False or  megamenu_view_type != 'cat_megamenu'
                                       
                                       "/>
                                <field name="display_menu_footer"/>
                                <field name="menu_footer" widget="html"
                                    invisible="display_menu_footer == False"
                                    required="display_menu_footer == True"/>
                              </group>
                            </page>
                            <page string="Grid Image Configuration"
                                 invisible="megamenu_view_type != 'cat_megamenu' or img_grid == False">
                                <group name="banner_image" string="Image Grid">
                                    <field name="banner_images_ids" class="o_website_sale_image_list" context="{'default_name': name}" mode="kanban" add-label="Add a Media" nolabel="1"/>
                                </group>
                            </page>
                            <page string="Product Configuration"
                                invisible="megamenu_view_type not in ('prod_megamenu')">
                              <group>
                                <field name="megamenu_product_ids" />
                              </group>
                            </page>
                            <page string="Service Configuration"
                                invisible="parent_megamenu_view_type != 'service_page_megamenu' and (megamenu_view_type != 'service_page_megamenu' or not is_service_menu)">
                                <group>
                                    <field name="img_menu"/>
                                    <field name="menu_desc"/>
                                </group>
                            </page>
                            <page string="Service menu content" invisible="parent_megamenu_view_type != 'service_content_megamenu' and (megamenu_view_type != 'service_content_megamenu' or not is_service_menu)">
                                <group>
                                    <field name='service_content' widget="html"/>
                                </group>
                            </page>   
                            <page string="Banner Image" invisible="megamenu_view_type not in ('prod_megamenu','service_banner_megamenu')">
                                <group>
                                    <field name="is_img_banner"/>
                                    <field name="img_banner" invisible="is_img_banner == False"/>
                                    <field name="img_banner_position" invisible="is_img_banner == False"/>
                                </group>
                            </page>
                            <page string="Service banner menu content" invisible="megamenu_view_type not in ('service_banner_megamenu')">
                                <group>
                                    <field name='menu_desc'/>
                                    <field name='banner_content' widget="html"/>
                                    <field name='service_content' widget="html"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Website Menu Action -->
        <record id="website.action_website_menu" model="ir.actions.act_window">
            <field name="name">Website Menu</field>
            <field name="res_model">website.menu</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_my_websites':1}</field>
        </record>

        <!-- Fonts are self-hosted (see migrations/19.0.0.17): Odoo's "host font
             locally" mechanism downloads Poppins once into an ir.attachment and
             serves it from this server, so the page never actually requests
             fonts.gstatic.com/fonts.googleapis.com. Lighthouse flags both
             preconnects as unused connection setup cost; drop them instead of
             adding a second one. -->
        <!-- theme_scita_fonts_preconnect: dropped in 20, core website.font_links only preconnects when Google fonts are used -->

        <!-- No font preloads (Odoo's two icon fonts and Scita's FontAwesome / Lineicons subsets).
             Odoo 19 measurements kept them (first paint waited for the icon fonts either way), but
             under Odoo 20 / Lighthouse 13 the four preloads held the page's first paint back about
             one more second on mobile, for every page that is not tiny (shop listing, categories,
             home; 2026-10-08, medians of 3: category 60 -> 71, shop 51 -> 58, home 57 -> 60). The
             fonts are small subsets requested as soon as the CSS is parsed, and still load (all 200). -->
        <template id="theme_scita_no_font_preloads" inherit_id="web.frontend_layout" name="Scita: no font preloads" priority="99">
            <!-- websites using another theme keep Odoo's preloads -->
            <xpath expr="//t[@t-call-assets='web.material_symbols_outlined']" position="attributes">
                <attribute name="t-if">not (request and request.env.website and request.env.website._scita_theme_active())</attribute>
            </xpath>
            <xpath expr="//t[@t-call-assets='web.odoo_ui_icons']" position="attributes">
                <attribute name="t-if">not (request and request.env.website and request.env.website._scita_theme_active())</attribute>
            </xpath>
        </template>

        <!-- Non-blocking load for the product-slider styles. media="print" keeps
             the stylesheet off the critical path, then it is promoted to
             media="all" as soon as it has downloaded. Safe because everything it
             styles arrives after load anyway (RPC-injected sliders, quick-view
             modal), so there is nothing on screen for it to restyle - and the
             href filter means we only ever promote our own sheet, never a real
             print stylesheet belonging to Odoo or another module. -->
        <!-- Start the LCP image downloading straight away instead of after the
             stylesheet clears the connection. See website._scita_lcp_preload_href
             for why this is derived from the page's own markup. -->
        <template id="theme_scita_preload_lcp_image" inherit_id="website.layout" name="Preload LCP Image">
            <xpath expr="//head" position="inside">
                <t t-set="scita_lcp_href" t-value="website._scita_lcp_preload_href(main_object) if website else False"/>
                <link t-if="scita_lcp_href" rel="preload" as="image" t-att-href="scita_lcp_href" fetchpriority="high"/>
            </xpath>
        </template>

        <!-- Break the @import chain for the self-hosted Google font. See
             website._scita_google_font_css_hrefs for why: the font CSS is
             @imported from inside web.assets_frontend, so without this the
             browser only discovers it after the whole bundle has parsed, and
             the woff2 files only after that again. Preloading the exact same
             URL here makes that fetch parallel instead of serial. -->
        <template id="theme_scita_preload_google_font" inherit_id="website.layout" name="Preload Self-Hosted Google Font CSS">
            <xpath expr="//head" position="inside">
                <t t-foreach="website._scita_google_font_css_hrefs() if website else []" t-as="scita_font_href">
                    <link rel="preload" as="style" t-att-href="scita_font_href"/>
                </t>
            </xpath>
        </template>

        <!-- Rows of products of each "Multi Product Snippet 1" configuration, for the height its
             placeholder reserves until the products are loaded (snippets.scss) -->
        <template id="theme_scita_product_snippet_rows" inherit_id="website.layout" name="Scita Product Snippet Rows">
            <xpath expr="//head" position="inside">
                <t t-set="scita_snippet_rows_css" t-value="website._scita_product_snippet_rows_css() if website else ''"/>
                <style t-if="scita_snippet_rows_css" t-out="scita_snippet_rows_css"/>
            </xpath>
        </template>

        <!-- Product page body class, server-side: product_details.js added it after load, and the
             product page rules keyed on it (e.g. its top margin) then moved the page down. -->
        <template id="theme_scita_product_page_body_class" inherit_id="website.layout" name="Scita Product Page Body Class">
            <xpath expr="//t[@t-set='body_classname']" position="after">
                <t t-if="main_object and main_object._name == 'product.template'" t-set="body_classname" t-valuef="{{body_classname}} sct-cst-pro-page"/>
            </xpath>
        </template>

        <template id="theme_scita_async_snippet_css" inherit_id="website.layout" name="Async Snippet Product CSS">
            <xpath expr="//head" position="inside">
                <!-- block styles: render-blocking on website pages made with Scita blocks (blocks at
                     the top of such a page reflowed when they arrived), asynchronous elsewhere -->
                <t t-if="website and (website._scita_page_has_theme_blocks(main_object) or website._scita_path_startswith('/deals-of-the-day'))" t-call-assets="theme_scita.assets_snippet_product_css" t-js="false" t-css="true"/>
                <t t-else="" t-call-assets="theme_scita.assets_snippet_product_css" t-js="false" t-css="true" media="print"/>
                <!-- shop / product styles: render-blocking under /shop and on the Scita pages built from
                     them (All Categories, Deals of the Day: their whole content moved when they
                     arrived, layout shift 0.9-1.0), asynchronous elsewhere. Same link order either way. -->
                <t t-if="website and website._scita_path_startswith('/shop', '/allcategories', '/deals-of-the-day')" t-call-assets="theme_scita.assets_shop_css" t-js="false" t-css="true"/>
                <t t-else="" t-call-assets="theme_scita.assets_shop_css" t-js="false" t-css="true" media="print"/>
                <t t-call-assets="theme_scita.assets_snippet_extra_css" t-js="false" t-css="true" media="print"/>
                <script type="text/javascript">
                    (function () {
                        var sel = 'link[rel="stylesheet"][media="print"][href*="theme_scita.assets_"]';
                        Array.prototype.forEach.call(document.querySelectorAll(sel), function (link) {
                            if (link.sheet) {
                                link.media = 'all';
                            } else {
                                link.addEventListener('load', function () { link.media = 'all'; });
                            }
                        });
                    })();
                </script>
            </xpath>
        </template>
        <!-- theme_scita_brand_promotion_fixed_size: dropped in 20, web.brand_promotion_message has no logo image anymore -->

</odoo>