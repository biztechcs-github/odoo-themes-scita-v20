<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    website product form page-->

    <!--    website product price template-->
    <!--  Common template for pop up modal-->
    <template id="request_for_quote_modal">
        <div id="cfp_pop_up" role="dialog" class="modal fade" tabindex="-1" aria-hidden="true" aria-labelledby="cfp_pop_up_title">
            <div class="modal-dialog modal-dialog-centered modal-lg sct_quote_dialog">
                <div class="modal-content">
                    <form method="POST" action="/quote_request/submit">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="product_id" id="product_id" t-att-value="product and product.id"/>
                        <div class="modal-header">
                            <div class="sct_quote_head">
                                <h4 class="modal-title" id="cfp_pop_up_title">Request a Quote</h4>
                                <p class="sct_quote_intro mb-0">Tell us what you need: we will reply with our best price.</p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                        </div>
                        <div class="modal-body">
                            <!-- filled in by request_quote.js from the button that opened the pop-up -->
                            <div t-attf-class="sct_quote_product #{'' if product else 'd-none'}">
                                <i class="fa fa-cube" role="presentation"/>
                                <!-- t-out inside, not on the span: with no product QWeb would drop the span,
                                     and request_quote.js writes the name of the clicked product into it -->
                                <span class="sct_quote_product_name"><t t-out="product and product.name"/></span>
                            </div>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label for="first_name" class="form-label">First name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="first_name" id="first_name" required="required" autocomplete="given-name"/>
                                </div>
                                <div class="col-sm-6">
                                    <label for="last_name" class="form-label">Last name</label>
                                    <input type="text" class="form-control" name="last_name" id="last_name" autocomplete="family-name"/>
                                </div>
                                <div class="col-sm-6">
                                    <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control" name="email" id="email" required="required" autocomplete="email"/>
                                </div>
                                <div class="col-sm-6">
                                    <label for="phone" class="form-label">Phone <span class="text-danger">*</span></label>
                                    <input type="tel" class="form-control" name="phone" id="phone" required="required" autocomplete="tel"/>
                                </div>
                                <div class="col-sm-4">
                                    <label for="quantity" class="form-label">Quantity <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" name="quantity" id="quantity" required="required" min="1" max="1000000" step="1" value="1"/>
                                </div>
                                <div class="col-12">
                                    <label for="message" class="form-label">Message</label>
                                    <textarea class="form-control" name="message" id="message" rows="3" placeholder="Size, finish, delivery date..."/>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal" id="request_modal_close">Cancel</button>
                            <button id="send_btn" type="submit" class="btn btn-primary">Send request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </template>

    <!--    product comparison page-->

    <!--    product wishlist page-->

    
</odoo>
