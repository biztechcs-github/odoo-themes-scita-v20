<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide Add To Cart Button and quantity selector if not website_show_price -->    
    <template id="product_details" inherit_id="website_sale.product_wishlist">
        
        <!-- 🧩 Request Quote / Login button in the wishlist action row.
             Odoo 20: it takes the Add to Cart slot, so it stays on one line
             with the compare / quick view buttons. -->
        <xpath expr="//div[hasclass('o_wsale_product_action_row')]/button[@name='add_to_cart']" position="before">
            <t t-if="website and (
                (not website.website_show_price)
                or wish.product_id.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">
                <!-- Case 1: User not logged in and login_see_price is enabled -->
                <a t-if="website.login_see_price and request.env.user._is_public()"
                   t-attf-href="/web/login?redirect={{ request.httprequest.path }}"
                   class="o_wsale_product_btn_primary btn btn-outline-primary login-price-btn">
                    Login to see price
                </a>
                <!-- Case 2: Price hidden (Request Quote) -->
                <a t-else=""
                   role="button"
                   id="request_for_quote_button"
                   data-bs-toggle="modal"
                   data-bs-target="#cfp_pop_up"
                   href="#"
                   t-att-data-product_id="wish.product_id.id"
                   class="o_wsale_product_btn_primary btn btn-primary">
                    Request Quote
                </a>
            </t>
        </xpath>

        <!-- 🧱 Hide price when conditions are met -->
        <xpath expr="//div[hasclass('container', 'oe_website_sale')]//div[hasclass('align-middle', 'o_wish_price')]" position="attributes">
            <attribute name="t-if">
                website 
                and website.website_show_price 
                and not wish.product_id.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <!-- 🧱 Hide 'Add to Cart' button when price is hidden (it carries t-else,
             so hide it with a class instead of t-if) -->
        <xpath expr="//div[hasclass('o_wsale_product_action_row')]/button[@name='add_to_cart']" position="attributes">
            <attribute name="t-attf-class">o_wsale_product_btn_primary btn btn-primary {{'' if (website and website.website_show_price and not wish.product_id.website_hide_price and not (website.login_see_price and request.env.user._is_public())) else 'd-none'}}</attribute>
        </xpath>
    </template>

           
    <!-- Request Quote or Login to See Price logic -->
    <template id="shop_price_hide_product_price" inherit_id="website_sale.products_item">
        <!-- Hide price block for shop page when hidden by any condition -->
        <xpath expr="//div[hasclass('product_price')]" position="attributes">
            <attribute name="t-if">
                website 
                and website.website_show_price
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <!-- Replace price block with buttons -->
        <xpath expr="//div[hasclass('product_price')]" position="after">
            <t t-if="website and (
                (not website.website_show_price)
                or product.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">

                <!-- Case 1: User is public and must log in -->
                <t t-if="website.login_see_price and request.env.user._is_public()">
                    
                    <a t-attf-href="/web/login"
                    class="btn btn-outline-primary mt-2 login-price-btn">
                        Login to see price
                    </a>
                </t>

                <!-- Case 2: Price hidden (Request Quote) -->
                <t t-else="">
                    <div class="o_wsale_product_request_quote">
                        <a role="button"
                        id="request_for_quote_button"
                        data-bs-toggle="modal"
                        data-bs-target="#cfp_pop_up"
                        t-att-data-product_id="product.id"
                        href="#"
                        class="btn btn-primary mt-2">
                            Request Quote
                        </a>
                    </div>
                </t>
            </t>
        </xpath>
    </template>

    <template id="shop_button_hide_product_price" inherit_id="website_sale.shop_product_buttons">

        <!-- Hide button block for shop page when hidden by any condition -->
        <xpath expr="//button[@name='add_to_cart']" position="attributes">
            <attribute name="t-if">
                website 
                and website.website_show_price
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <!-- Replace price block with buttons -->
        <xpath expr="//button[@name='add_to_cart']" position="after">
            <t t-if="website and (
                (not website.website_show_price)
                or product.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">

                <!-- Case 1: User is public and must log in
                <t t-if="website.login_see_price and request.env.user._is_public()">
                    
                    <a t-attf-href="/web/login"
                    class="btn btn-outline-primary mt-2 login-price-btn">
                        Login to see price
                    </a>
                </t> -->
            </t>
        </xpath>
    </template>

    <!-- Product compare detail start -->
    <template id="product_compare_detail" inherit_id="website_sale.product_compare">
        
        <!-- 🧩 Add Request Quote / Login button before price -->
        <xpath expr="//span[@t-out=&quot;combination_info['price']&quot;]" position="before">
            <t t-if="website and (
                (not website.website_show_price)
                or product.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">
                
                <!-- Case 1: User not logged in and login_see_price is enabled -->
                <t t-if="website.login_see_price and request.env.user._is_public()">
                    
                    <a t-attf-href="/web/login"
                    class="btn btn-outline-primary mt-2 login-price-btn">
                        Login to see price
                    </a>
                </t>
                
                <!-- Case 2: Price hidden (Request Quote) -->
                <t t-else="">
                    <a role="button"
                    id="request_for_quote_button"
                    data-bs-toggle="modal"
                    data-bs-target="#cfp_pop_up"
                    href="#"
                    t-att-data-product_id="product.id"
                    class="btn btn-primary mt-2">
                        Request Quote
                    </a>
                </t>
            </t>
        </xpath>

        <!-- 🧱 Hide price span when price is hidden -->
        <xpath expr="//span[@t-out=&quot;combination_info['price']&quot;]" position="attributes">
            <attribute name="t-if">
                website 
                and website.website_show_price 
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <!-- 🧱 Hide 'Add to Cart' button in same conditions -->
        <!-- Odoo 20: the button carries t-else, so hide it with a class instead of t-if -->
        <xpath expr="//button[@name='add_to_cart']" position="attributes">
            <attribute name="t-attf-class">btn btn-primary {{'' if (website and website.website_show_price and not product.website_hide_price and not (website.login_see_price and request.env.user._is_public())) else 'd-none'}}</attribute>
        </xpath>

    </template>

    <!-- Product compare detail end -->

    <template id="default_add_to_cart_hide_website_sale" inherit_id="website_sale.shop_product_buttons">
        <xpath expr="//button[@name='add_to_cart']" position="attributes">
            <attribute name="t-if">
                    website and website.website_show_price and not product.website_hide_price
            </attribute>
        </xpath>
    </template>

    <!-- Hide Add to Cart and show Login/Quote in Quick View -->
    <template id="add_to_card_hide_price_quick_view" inherit_id="theme_scita.shop_quick_view_modal">
        <!-- 🧱 Hide Add to Cart button -->
        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute name="t-if">
                website 
                and website.website_show_price 
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <!-- 🧱 Hide price block or main product section -->
        <xpath expr="//div[hasclass('js_main_product')]//div" position="attributes">
            <attribute name="t-if">
                website 
                and website.website_show_price 
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <!-- 🧩 Show 'Login to see price' or 'Request Quote' -->
        <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
            <t t-if="website and (
                (not website.website_show_price)
                or product.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">

                <!-- Case 1: User not logged in & login required -->
                <t t-if="website.login_see_price and request.env.user._is_public()">
                    
                    <a t-attf-href="/web/login"
                    class="btn btn-outline-primary mt-2 login-price-btn">
                        Login to see price
                    </a>
                </t>

                <!-- Case 2: Hide price → Request Quote -->
                <t t-else="">
                    <a role="button"
                    id="request_for_quote_button"
                    data-bs-toggle="modal"
                    data-bs-target="#cfp_pop_up"
                    href="#"
                    t-att-data-product_id="product.id"
                    class="btn btn-primary mt-2">
                        Request Quote
                    </a>
                </t>
            </t>
        </xpath>

    </template>
    
