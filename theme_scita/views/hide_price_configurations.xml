   <!-- The one Request Quote pop-up of every page. It used to be added again by the
        product, shop, compare and wishlist pages too: with several #cfp_pop_up in the
        page, Bootstrap opened the in-page copy, which on the wishlist showed inline
        instead of as a pop-up. It also sat after </html>; now at the end of <body>. -->
   <template id="theme_scita_home_page" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="after">
            <t t-call="theme_scita.request_for_quote_modal"/>
        </xpath>
   </template>

    <template id="display_request_quote_in_pdp_template" inherit_id="theme_scita.theme_scita_product_details_add_to_cart">

        <!-- 🧱 Hide Add to Cart area if price hidden or login required.
             Odoo 20 reads the product ids from the add-to-cart button on every variant
             change, so the block stays in the DOM (hidden) instead of being removed. -->
        <xpath expr="//div[hasclass('sct-main-price-description')]" position="attributes">
            <attribute name="t-attf-class">sct-main-price-description #{'' if (website and website.website_show_price and not product.website_hide_price and not (website.login_see_price and request.env.user._is_public())) else 'd-none'}</attribute>
        </xpath>

        <!-- 🧩 Insert "Login to See Price" / "Request Quote" buttons -->
        <xpath expr="//div[hasclass('sct-other-desciption')]" position="inside">
            <!-- Odoo 20: with Buy Now enabled, hide_PDP_buy_now_btn_template already
                 renders this button next to the quantity, so skip it here. -->
            <t t-set="sct_buy_now_shows_btn" t-value="is_view_active('website_sale.product_buy_now') and (
                product.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )"/>
            <t t-if="website and not sct_buy_now_shows_btn and (
                (not website.website_show_price)
                or product.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">

                <!-- Case 1: Login required -->
                <t t-if="website.login_see_price and request.env.user._is_public()">
                    <t t-set="redirect_url" t-value="request.httprequest.path"/>
                    <a t-attf-href="/web/login?redirect={{ redirect_url }}"
                    class="btn btn-outline-primary btn_cta mt-2 login-price-btn">
                        Login to see price
                    </a>
                </t>

                <!-- Case 2: Hide price or "Request Quote" scenario -->
                <t t-else="">
                    <a role="button"
                    id="request_for_quote_button"
                    data-bs-toggle="modal"
                    data-bs-target="#cfp_pop_up"
                    href="#"
                    t-att-data-product_id="product.id"
                    class="btn btn-primary btn_cta mt-2">
                        Request Quote
                    </a>
                </t>

            </t>
        </xpath>

    </template>
    <!-- ========================================================= -->
    <!-- Cart page / checkout: hide prices with Request Quote or  -->
    <!-- login to see price (website._sct_hide_* in models/website.py) -->
    <!-- ========================================================= -->

    <!-- Line price: shared by the cart page and the checkout summary -->
    <template id="sct_hide_cart_product_price" inherit_id="website_sale.cart_product_price" name="Scita: hide cart line price">
        <xpath expr="//span" position="attributes">
            <attribute name="t-if">not (website and website._sct_hide_line_price(line))</attribute>
        </xpath>
    </template>

    <template id="sct_hide_cart_lines_price" inherit_id="website_sale.cart_lines_price" name="Scita: hide cart line strikethrough / unit price">
        <xpath expr="//del" position="attributes">
            <attribute name="t-if">line._should_show_strikethrough_price() and not (website and website._sct_hide_line_price(line))</attribute>
        </xpath>
        <xpath expr="//div[hasclass('cart_product_base_unit_price')]" position="attributes">
            <attribute name="t-if">website.show_product_reference_price and line.product_id.base_unit_price and not website._sct_hide_line_price(line)</attribute>
        </xpath>
    </template>

    <!-- Subtotal / taxes / total (cart, checkout, payment, confirmation).
         Hidden with d-none, not removed: Odoo's checkout JS updates these rows
         when the delivery method changes and crashes if they are missing. -->
    <template id="sct_hide_cart_total" inherit_id="website_sale.total" name="Scita: hide cart totals">
        <xpath expr="//div[contains(@t-attf-class, 'o_cart_total')]" position="attributes">
            <attribute name="t-attf-class">o_cart_total #{_cart_total_classes} #{'d-none' if website and website._sct_hide_order_prices(website_sale_order) else ''}</attribute>
        </xpath>
    </template>

    <!-- Mobile "Order $ total" summary button on checkout pages -->
    <template id="sct_hide_checkout_mobile_total" inherit_id="website_sale.checkout_layout" name="Scita: hide mobile summary total">
        <xpath expr="//span[@id='amount_total_summary']" position="attributes">
            <attribute name="t-attf-class">monetary_field ms-auto #{'d-none' if website and website._sct_hide_order_prices(website_sale_order) else ''}</attribute>
        </xpath>
    </template>

    <!-- Quick reorder panel on the cart page -->
    <template id="sct_hide_quick_reorder_price" inherit_id="website_sale.quick_reorder_history" name="Scita: hide quick reorder price">
        <xpath expr="//small[hasclass('o_wsale_quick_reorder_product_price')]" position="attributes">
            <attribute name="t-if">not website._sct_hide_line_price(order_line)</attribute>
        </xpath>
    </template>

    <!-- Suggested accessories on the cart page (combination_info is set inside the
         price h6 and used after it, so hide its children rather than the h6) -->
    <template id="sct_hide_suggested_product_price" inherit_id="website_sale.suggested_products_list" name="Scita: hide suggested product price">
        <xpath expr="//del[@name='suggested_product_list_price']" position="attributes">
            <attribute name="t-if">not (website._sct_hide_line_price(False) or product.website_hide_price)</attribute>
        </xpath>
        <xpath expr="//span[@name='suggested_product_price']" position="attributes">
            <attribute name="t-if">not (website._sct_hide_line_price(False) or product.website_hide_price)</attribute>
        </xpath>
        <xpath expr="//t[@t-call='website_sale.base_unit_price']" position="attributes">
            <attribute name="t-if">combination_info.get('base_unit_price') and not (website._sct_hide_line_price(False) or product.website_hide_price)</attribute>
        </xpath>
    </template>
    <!-- Request Quote / login to see price: no checkout. The server blocks it too
         (sale.order._is_cart_ready_for_checkout in models/sale_order.py). -->
    <template id="sct_hide_checkout_buttons" inherit_id="website_sale.navigation_buttons" name="Scita: no checkout when prices are hidden">
        <xpath expr="//t[@t-if='website_sale_order and website_sale_order.website_order_line']" position="before">
            <t t-set="sct_no_checkout" t-value="website_sale_order and website and website._sct_hide_order_prices(website_sale_order)"/>
            <div t-if="sct_no_checkout" class="sct_no_checkout_notice alert alert-info mb-0">
                <t t-if="website.login_see_price and website.is_public_user()">
                    Please <a href="/web/login?redirect=/shop/cart">log in</a> to see the prices and place your order.
                </t>
                <t t-else="">
                    Prices of some products in your cart are available on request.
                    Please request a quote for them instead of checking out.
                </t>
            </div>
        </xpath>
        <xpath expr="//t[@t-if='website_sale_order and website_sale_order.website_order_line']" position="attributes">
            <attribute name="t-if">website_sale_order and website_sale_order.website_order_line and not sct_no_checkout</attribute>
        </xpath>
        <xpath expr="//div[@t-if='not hide_payment_button']" position="attributes">
            <attribute name="t-if">not hide_payment_button and not sct_no_checkout</attribute>
        </xpath>
    </template>
</odoo>