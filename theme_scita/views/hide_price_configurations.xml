<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide Add To Cart Button and quantity selector if not website_show_price -->    
    <template id="product_details" inherit_id="website_sale.product_wishlist">
        
        <!-- 🧩 Request Quote / Login button in the wishlist action row.
             Odoo 20: it takes the Add to Cart slot, so it stays on one line
             with the compare / quick view buttons. First of the row's
             t-if / t-else, so that only one of the three buttons shows:
             between Contact Us and Add to Cart it left Add to Cart next to Contact Us. -->
        <xpath expr="//div[hasclass('o_wsale_product_action_row')]/a[contains(@t-if, 'prevent_sale')]" position="before">
            <t t-if="website and (
                (not website.website_show_price)
                or wish.product_id.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">
                <!-- Case 1: User not logged in and login_see_price is enabled -->
                <!-- icon + .o_label like Odoo's Add to Cart: Odoo hides the label on narrow
                     cards (phones), where the text wrapped and stretched the row -->
                <a t-if="website.login_see_price and request.env.user._is_public()"
                   t-attf-href="/web/login?redirect={{ request.httprequest.path }}"
                   class="o_wsale_product_btn_primary btn btn-outline-primary login-price-btn"
                   title="Login to see price" aria-label="Login to see price">
                    <span class="d-inline-flex align-items-baseline">
                        <i class="fa fa-fw fa-sign-in" role="presentation"/>
                        <span class="o_label small ms-1">Login to see price</span>
                    </span>
                </a>
                <!-- Case 2: Price hidden (Request Quote) -->
                <a t-else=""
                   role="button"
                   id="request_for_quote_button"
                   data-bs-toggle="modal"
                   data-bs-target="#cfp_pop_up"
                   href="#"
                   t-att-data-product_id="wish.product_id.product_tmpl_id.id"
                   t-att-data-product-name="wish.product_id.name"
                   class="o_wsale_product_btn_primary btn btn-primary"
                   title="Request Quote" aria-label="Request Quote">
                    <span class="d-inline-flex align-items-baseline">
                        <i class="oi oi-fw o_not-animable" data-icon="mail" role="presentation"/>
                        <span class="o_label small ms-1">Request Quote</span>
                    </span>
                </a>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_action_row')]/a[contains(@t-if, 'prevent_sale')]" position="attributes">
            <attribute name="t-if"/>
            <attribute name="t-elif">combination_info['prevent_sale']</attribute>
        </xpath>
        <!-- "Hide Add Cart Button" (visitors), as on the product page -->
        <xpath expr="//div[hasclass('o_wsale_product_action_row')]/button[@name='add_to_cart']" position="attributes">
            <attribute name="t-else"/>
            <attribute name="t-elif">not (website.add_to_cart and request.env.user._is_public())</attribute>
        </xpath>

        <!-- the "Hidden price message" in the hidden price's place -->
        <xpath expr="//div[hasclass('container', 'oe_website_sale')]//div[hasclass('align-middle', 'o_wish_price')]" position="after">
            <t t-set="sct_hidden_price_message" t-value="wish.product_id.product_tmpl_id._sct_hidden_price_message()"/>
            <div t-if="sct_hidden_price_message" class="sct_hidden_price_message small text-muted">
                <span t-out="sct_hidden_price_message"/>
            </div>
        </xpath>

        <!-- 🧱 Hide price when conditions are met -->
        <xpath expr="//div[hasclass('container', 'oe_website_sale')]//div[hasclass('align-middle', 'o_wish_price')]" position="attributes">
            <attribute name="t-if">
                website 
                and website.website_show_price 
                and not wish.product_id.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>
    </template>

           
    <!-- Request Quote or Login to See Price logic -->
    <template id="shop_price_hide_product_price" inherit_id="website_sale.products_item">
        <!-- Hide price block for shop page when hidden by any condition (a "Request Quote"
             product hides it too, as its page does: it shows Contact Us there) -->
        <xpath expr="//div[hasclass('product_price')]" position="attributes">
            <attribute name="t-if">
                website
                and website.website_show_price
                and not product.website_hide_price
                and not product.quote_request
                and not website.hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <!-- Replace price block with buttons -->
        <xpath expr="//div[hasclass('product_price')]" position="after">
            <t t-if="website and (
                (not website.website_show_price)
                or product.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">

                <!-- Case 1: User is public and must log in -->
                <t t-if="website.login_see_price and request.env.user._is_public()">
                    
                    <a t-attf-href="/web/login?redirect={{ request.httprequest.path }}"
                    class="btn btn-outline-primary mt-2 login-price-btn">
                        Login to see price
                    </a>
                </t>

                <!-- Case 2: Price hidden (Request Quote) -->
                <t t-else="">
                    <div class="o_wsale_product_request_quote">
                        <a role="button"
                        id="request_for_quote_button"
                        data-bs-toggle="modal"
                        data-bs-target="#cfp_pop_up"
                        t-att-data-product_id="product.id"
                        t-att-data-product-name="product.name"
                        href="#"
                        class="btn btn-primary mt-2"
                        title="Request Quote" aria-label="Request Quote">
                            <!-- icon only shown where the card is too narrow for the label
                                 (hover style 5 next to compare / wishlist / quick view) -->
                            <i class="oi o_not-animable o_sct_rq_icon d-none" data-icon="mail" role="presentation"/>
                            <span class="o_sct_rq_label">Request Quote</span>
                        </a>
                    </div>
                </t>
            </t>
        </xpath>

        <!-- the "Hidden price message" in the price's place, above the button above (an
             "after" on the same node goes first). Request Quote products too. -->
        <xpath expr="//div[hasclass('product_price')]" position="after">
            <t t-set="sct_hidden_price_message" t-value="product._sct_hidden_price_message()"/>
            <div t-if="sct_hidden_price_message" class="sct_hidden_price_message small text-muted">
                <span t-out="sct_hidden_price_message"/>
            </div>
        </xpath>
    </template>

    <template id="shop_button_hide_product_price" inherit_id="website_sale.shop_product_buttons">

        <!-- Hide button block for shop page when hidden by any condition -->
        <xpath expr="//button[@name='add_to_cart']" position="attributes">
            <attribute name="t-if">
                website 
                and website.website_show_price
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <!-- Replace price block with buttons -->
        <xpath expr="//button[@name='add_to_cart']" position="after">
            <t t-if="website and (
                (not website.website_show_price)
                or product.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">

                <!-- Case 1: User is public and must log in
                <t t-if="website.login_see_price and request.env.user._is_public()">
                    
                    <a t-attf-href="/web/login"
                    class="btn btn-outline-primary mt-2 login-price-btn">
                        Login to see price
                    </a>
                </t> -->
            </t>
        </xpath>
    </template>

    <!-- Product compare detail start -->
    <template id="product_compare_detail" inherit_id="website_sale.product_compare">
        
        <!-- "Hidden price message" where the price would be (outside Odoo's hide_price t-if around the price) -->
        <xpath expr="//div[@id='o_comparelist_product_name']/span[@t-if=&quot;not combination_info['hide_price']&quot;]" position="before">
            <t t-set="sct_hidden_price_message" t-value="product.product_tmpl_id._sct_hidden_price_message()"/>
            <div t-if="sct_hidden_price_message" class="sct_hidden_price_message small text-muted">
                <span t-out="sct_hidden_price_message"/>
            </div>
        </xpath>
        <!-- 🧩 Request Quote / Login button in the Add to Cart slot: first of the column's
             t-if / t-else, so that only one action shows (as on the wishlist above).
             Not next to the price: Odoo's span around it is off exactly when it must show. -->
        <xpath expr="//div[@id='o_comparelist_product_name']/div/a[contains(@t-if, 'prevent_sale')]" position="before">
            <t t-if="website and (
                (not website.website_show_price)
                or product.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">
                
                <!-- Case 1: User not logged in and login_see_price is enabled -->
                <!-- full_path: the page is empty without its ?products= -->
                <t t-if="website.login_see_price and request.env.user._is_public()">
                    
                    <a t-attf-href="/web/login?redirect={{ request.httprequest.full_path }}"
                    class="btn btn-outline-primary mt-2 login-price-btn">
                        Login to see price
                    </a>
                </t>
                
                <!-- Case 2: Price hidden (Request Quote) -->
                <t t-else="">
                    <a role="button"
                    id="request_for_quote_button"
                    data-bs-toggle="modal"
                    data-bs-target="#cfp_pop_up"
                    href="#"
                    t-att-data-product_id="product.product_tmpl_id.id"
                    t-att-data-product-name="product.name"
                    class="btn btn-primary mt-2">
                        Request Quote
                    </a>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[@id='o_comparelist_product_name']/div/a[contains(@t-if, 'prevent_sale')]" position="attributes">
            <attribute name="t-if"/>
            <attribute name="t-elif">combination_info['prevent_sale']</attribute>
        </xpath>
        <!-- "Hide Add Cart Button" (visitors), as on the product page -->
        <xpath expr="//div[@id='o_comparelist_product_name']//button[@name='add_to_cart']" position="attributes">
            <attribute name="t-else"/>
            <attribute name="t-elif">not (website.add_to_cart and request.env.user._is_public())</attribute>
        </xpath>

        <!-- 🧱 The sticky mini overview at the top of the page shows prices too -->
        <xpath expr="//div[@id='miniStickyComparison']//div[@t-if=&quot;not combination_info['hide_price']&quot;]" position="attributes">
            <attribute name="t-if">
                not combination_info['hide_price']
                and website
                and website.website_show_price
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

    </template>

    <!-- Product compare detail end -->

    <template id="default_add_to_cart_hide_website_sale" inherit_id="website_sale.shop_product_buttons">
        <xpath expr="//button[@name='add_to_cart']" position="attributes">
            <attribute name="t-if">
                    website and website.website_show_price and not product.website_hide_price
            </attribute>
        </xpath>
    </template>

    <!-- Hide Add to Cart and show Login/Quote in Quick View -->
    <template id="add_to_card_hide_price_quick_view" inherit_id="theme_scita.shop_quick_view_modal">
        <!-- 🧱 Hide Add to Cart button -->
        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute name="t-if">
                website 
                and website.website_show_price 
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <!-- 🧱 Hide the price block (not the first div: that is the description) -->
        <xpath expr="//div[hasclass('js_main_product')]/div[t[@t-call='website_sale.product_price']]" position="attributes">
            <attribute name="t-if">
                website 
                and website.website_show_price 
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <!-- the "Hidden price message" in the price's place (before the button below) -->
        <xpath expr="//div[@id='add_to_cart_wrap']" position="before">
            <t t-set="sct_hidden_price_message" t-value="product._sct_hidden_price_message()"/>
            <div t-if="sct_hidden_price_message" class="alert alert-light border sct_hidden_price_message mt-2 mb-0">
                <i class="fa fa-info-circle me-1" role="presentation"/>
                <span t-out="sct_hidden_price_message"/>
            </div>
        </xpath>

        <!-- 🧩 Show 'Login to see price' or 'Request Quote' -->
        <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
            <t t-if="website and (
                (not website.website_show_price)
                or product.website_hide_price
                or (website.login_see_price and request.env.user._is_public())
            )">

                <!-- Case 1: User not logged in & login required -->
                <!-- rendered through an RPC: the request path is that route, not a page -->
                <t t-if="website.login_see_price and request.env.user._is_public()">
                    
                    <a t-attf-href="/web/login?redirect={{ product.website_url }}"
                    class="btn btn-outline-primary mt-2 login-price-btn">
                        Login to see price
                    </a>
                </t>

                <!-- Case 2: Hide price → Request Quote -->
                <t t-else="">
                    <a role="button"
                    id="request_for_quote_button"
                    data-bs-toggle="modal"
                    data-bs-target="#cfp_pop_up"
                    href="#"
                    t-att-data-product_id="product.id"
                    t-att-data-product-name="product.name"
                    class="btn btn-primary mt-2">
                        Request Quote
                    </a>
                </t>
            </t>
        </xpath>

    </template>
    
    <!-- ========================================================= -->
    <!-- 🔒 Universal "Hide or Login to See Price" logic for Scita snippet -->
    <!-- The snippets are rendered through RPCs (the request path is that route, not a -->
    <!-- page), so their Login links come back to the product's own page. -->
    <!-- ========================================================= -->

    <!-- 🧩 Product image snippet -->
    <template id="product_image_snippet_price" inherit_id="theme_scita.sct_product_snippet_2_view">
        <xpath expr="//p[hasclass('price')]" position="attributes">
            <attribute name="t-if">website and not product._sct_price_hidden()</attribute>
        </xpath>

        <xpath expr="//div[hasclass('ajax_cart_template')]" position="attributes">
            <attribute name="t-if">
                website and website.website_show_price 
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

        <xpath expr="//div[hasclass('ajax_cart_template')]" position="after">
            <t t-if="website">
                <t t-if="request.env.user._is_public() and website.login_see_price">
                    <a t-attf-href="/web/login?redirect={{ product.website_url }}"
                    class="btn btn-outline-primary login-price-btn">
                    Login to see price
                    </a>
                </t>
                <t t-elif="(product.website_hide_price or not website.website_show_price)">
                    <div class="o_wsale_product_request_quote">
                        <a href="#" role="button"
                            data-bs-toggle="modal" 
                            data-bs-target="#cfp_pop_up"
                            t-att-data-product_id="product.id"
                            t-att-data-product-name="product.name"
                            id="request_for_quote_button"
                            class="btn request_for_quote_button">
                                Request Quote
                        </a>
                    </div>
                </t>
            </t>
        </xpath>
    </template>


    <!-- 🧩 Fashion Multi Category Slider -->
    <template id="fashion_multi_cat_slider_snippet_price" inherit_id="theme_scita.fashion_multi_slider_products">
        <xpath expr="//p[hasclass('price')]" position="attributes">
            <attribute name="t-if">website and not product._sct_price_hidden()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('ajax_cart_template')]" position="attributes">
            <attribute name="t-if">
                website and website.website_show_price 
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
            </attribute>
        </xpath>

            <!-- Show Login or Quote Button Based on Conditions -->
        <xpath expr="//div[hasclass('ajax_cart_template')]" position="after">
            <t t-if="website">
                <!-- CASE 1: Public user -->
                <t t-if="request.env.user._is_public() and website.login_see_price">
                    <a t-attf-href="/web/login?redirect={{ product.website_url }}"
                    class="btn btn-outline-primary login-price-btn">
                    Login to see price
                    </a>
                </t>
                <!-- CASE 3 & 4: Logged-in user but price hidden -->
                <t t-elif="(product.website_hide_price or not website.website_show_price)">
                    <div class="o_wsale_product_request_quote">
                        <a href="#" role="button"
                            data-bs-toggle="modal" 
                            data-bs-target="#cfp_pop_up"
                            t-att-data-product_id="product.id"
                            t-att-data-product-name="product.name"
                            id="request_for_quote_button"
                            class="btn request_for_quote_button">
                                Request Quote
                        </a>
                    </div>
                </t>
            </t>
        </xpath>
    </template>


    <!-- 🧩 Multi Deal Seller Slider -->
    <template id="multi_deal_seller_snippet_price" inherit_id="theme_scita.multi_deal_seller_slider_view">
        <xpath expr="//p[hasclass('price')]" position="attributes">
            <attribute name="t-if">website and not product._sct_price_hidden()</attribute>
        </xpath>
    </template>


    <!-- 🧩 Deal of the Day -->
    <template id="deal_of_the_day_snippet_price" inherit_id="theme_scita.theme_scita_deal_of_the_day_view">
        <xpath expr="//p[hasclass('price')]" position="attributes">
            <attribute name="t-if">website and not deal_product._sct_price_hidden()</attribute>
        </xpath>
        <xpath expr="//button[hasclass('cart_view_sct_btn', 'js_add_cart')]" position="attributes">
            <attribute name="t-if">
                website and website.website_show_price 
                and not deal_product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
                and not combination_info.get('prevent_sale')
                and not (website.add_to_cart and request.env.user._is_public())
            </attribute>
        </xpath>

        <xpath expr="//button[hasclass('cart_view_sct_btn', 'js_add_cart')]" position="after">
            <t t-if="website">
                <!-- CASE 1: Public user -->
                <t t-if="request.env.user._is_public() and website.login_see_price">
                    <a t-attf-href="/web/login?redirect={{ deal_product.website_url }}"
                    class="btn btn-outline-primary login-price-btn">
                    Login to see price
                    </a>
                </t>
                <!-- CASE 3 & 4: Logged-in user but price hidden -->
                <t t-elif="(deal_product.website_hide_price or not website.website_show_price)">
                    <div class="o_wsale_product_request_quote">
                         <a href="#" role="button"
                            data-bs-toggle="modal" 
                            data-bs-target="#cfp_pop_up"
                            t-att-data-product_id="deal_product.id"
                            t-att-data-product-name="deal_product.name"
                            id="request_for_quote_button"
                            class="btn request_for_quote_button">
                                Request Quote
                        </a>
                    </div>
                </t>
            </t>
        </xpath>
    </template>


    <!-- 🧩 Product Snippet 1 -->
    <template id="sct_product_snippet_1_price" inherit_id="theme_scita.sct_product_snippet_1_view">
        <xpath expr="//p[hasclass('price')]" position="attributes">
            <attribute name="t-if">website and not product._sct_price_hidden()</attribute>
        </xpath>
        <xpath expr="//button[hasclass('cart_view_sct_btn')]" position="attributes">
            <attribute name="t-if">
                website and website.website_show_price 
                and not product.website_hide_price
                and not (website.login_see_price and request.env.user._is_public())
                and not combination_info.get('prevent_sale')
                and not (website.add_to_cart and request.env.user._is_public())
            </attribute>
        </xpath>

        <xpath expr="//div[hasclass('pwp-info')]" position="after">
        <t t-if="website">
                <!-- CASE 1: Public user -->
                <t t-if="request.env.user._is_public() and website.login_see_price">
                    <a t-attf-href="/web/login?redirect={{ product.website_url }}"
                    class="btn btn-outline-primary login-price-btn">
                    Login to see price
                    </a>
                </t>
                <!-- CASE 3 & 4: Logged-in user but price hidden -->
                <t t-elif="(product.website_hide_price or not website.website_show_price)">
                    <div class="o_wsale_product_request_quote">
                         <a href="#" role="button"
                            data-bs-toggle="modal" 
                            data-bs-target="#cfp_pop_up"
                            t-att-data-product_id="product.id"
                            t-att-data-product-name="product.name"
                            id="request_for_quote_button"
                            class="btn request_for_quote_button">
                                Request Quote
                        </a>
                    </div>
